---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE, DEMOREEL } from '../consts';
import "../styles/animations.css";

import Vignette from '../components/widgets/Vignette.astro';
import HorizontalCarousel from '../components/widgets/HorizontalCarousel.astro';
import HomeRibbon from '../components/props/HomeRibbon.astro';
import SoftwareChip from '../components/props/SoftwareChip.astro';
import ToolCard from '../components/cards/ToolCard.astro';
import CreditCard from '../components/cards/CreditCard.astro';

import HomeHero from '../components/pages/home-hero.astro';

import { creditLibrary } from '../data/CreditsLibrary';
import { getActiveTools } from '../data/ToolLibrary';
const activeTools = getActiveTools();


import { getCollection } from 'astro:content';
const toolEntries = (await getCollection('tool'))
    .filter(entry => entry.data.featured)
    .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());


const lastCredits = [...creditLibrary]
	.sort((a, b) => b.year - a.year)
	.slice(0, 3);

---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header showThemeToggle={false}/>
		
		<div class="home-container">
			<main>
				<div class="overlap-group">
					<section class="home-hero">
						<HomeHero/>
					</section>
					<div class="home-ribbon">
						<HomeRibbon/>
					</div>
					
				
					<div class="rest">
						<section class="home-portfolio">
							<div class="home-portfolio-container">
								<span class="home-title">What I build</span>
								<p class="home-subhead">For artists and pipelines.
									<a href="/work/tools" class="btn btn-secondary">All tools</a>
								</p>
		
								<HorizontalCarousel class="tool-card-placeholder" itemSize='32vh' gap={2} navigation='none'>
									<ToolCard index={0} variant="full" />
								</HorizontalCarousel>
								<HorizontalCarousel class="tool-card-selected" itemSize='32vh' gap={0} navigation='none'>
									{toolEntries.map((entry, i) => (
										<div class="fan-item">
											<ToolCard entry={entry} index={i} variant="full" />
										</div>
									))}
								</HorizontalCarousel>
								<HorizontalCarousel class="home-softwareChips" itemSize='11vh' gap={1}>
									{activeTools.map(tool => <SoftwareChip tool={tool} />)}
								</HorizontalCarousel>
								
							</div>
						</section>
						<section class="home-credits">
							<div class="home-credits-container">
								<span class="home-title">LAST CREDITS</span>
								<HorizontalCarousel itemSize='34vh' gap={2} navigation='buttons' buttonPosition="top" buttonJustify='right'>
									{lastCredits.map((credit, i) => (
										<CreditCard entry={credit} index={i} variant="full" />
									))}
								</HorizontalCarousel>
							</div>
							
						</section>
						<section class="home-ending">


						</section>
					</div>
				</div>
				
			</main>
		</div>
		<Footer/>
		<Vignette />
	</body>
</html>


<style> 

	body {
		-webkit-tap-highlight-color: transparent;
		-webkit-user-drag: none;
		-webkit-touch-callout: none;
		-webkit-user-select: none;
	}


	:root {
        --home-title: #BDAEB2;
    }
	


	/* -------------------------------------------------------------- */ 
	/* ---------------------- MAIN SECTIONS ------------------------- */ 
	/* -------------------------------------------------------------- */ 
	.home-container::before {
		content: "";
		position: absolute;
		inset: 0;
		transform: scale(1);
		z-index: -1;
		
	}

	.home-container{
		width: 100%;
	}
	


	.home-title {
		
        color: var(--home-title); 
		font-family: 'Barqen', sans-serif;
		text-transform: uppercase;
		font-weight: 700;
		letter-spacing: 4px;
		user-select: none;
		
	}

	.overlap-group {
		position: relative;
		isolation: isolate;
	}

	.home-hero {
        position: sticky;
        top: 0;
        z-index: 1;
        min-height: 89vh;
        overflow: hidden;
		display: flex;
        align-items: center;
        justify-content: center;
		
    }


    .home-hero::before {
        content: "";
        position: absolute;
        inset: 0;
        background-image: url('../assets/BG/BG_MainHome_High_Home_v01.jpg');
        background-repeat: no-repeat;
        background-size: cover;
        background-position: top center;
        filter: blur(1.6px) brightness(1);
        transform: scale(1.0);
        z-index: -1;
    }

	.home-ribbon{
		position: absolute;
		top: 86vh;
		left: 0.1%;
		width: 100%;
		height: 5.4vh;
		overflow: hidden;
		z-index: 10;
		display: flex;
		align-items: center;
		transform: rotate(-1.3deg);
		box-sizing: border-box;
	}


	.rest {
		position: relative;
		z-index: 2;
		background-image: url('../assets/BG/BG_MainHome_High_Sections_v01.jpg');
		background-repeat: no-repeat;
		background-size: cover;
		background-position: top center;
		
		clip-path: polygon(0 2.3%, 100% 0, 100% 100%, 0 100%);
    	margin-top: -3.5vh;
	}



	.home-credits {
		position: relative;
		min-height: 100vh;

		display: flex;
		flex-direction: column;
		justify-content: center;
		align-items: center;
	}

	.home-credits-container{
		height: 70vh;
	}

	.home-ending {
		position: relative;
		min-height: 48vh;
	}

	section {
		display: block;
		scroll-snap-align: start;
	}


	body {
		margin: 0;
		padding: 0;
	}

	main {
		width: 100%;
		max-width: 100%;
		margin: 0;
		padding: 0;
	}

	.home-portfolio {
		position: relative;
		height: 100vh;

		display: flex;
        align-items: center;
        justify-content: center;
	}

	.home-portfolio-container {
		display: grid;
		align-content: start; 
        grid-template-areas: 
        "header"
        "subhead"
        "cards"
		"chips";
        align-items: center;
		overflow: hidden;
		height: 85vh;
		margin-top: 6vh;
		width: 100vw;
		max-width: 1900px;
	}


	.home-portfolio .home-title {
		grid-area: header;
		color: #BA4964;
		font-size: 80px;
		line-height: 1.2;
		letter-spacing: 8px;
		display: inline-block;
		text-transform: uppercase;
		text-shadow: 
            -4px -4px 0 #050304,  
             4px -4px 0 #050304,
            -8px  8px 0 #050304,
             8px  8px 0 #050304;

		
		padding-left: 1.5rem;
		justify-self: center;
		margin-bottom: -0.9rem;
	}

	.home-portfolio .home-subhead {
		grid-area: subhead;
        font-size: 21px;
        color: #A38C95;
        max-width: 420px;
        justify-self: center;
		line-height: 1;
		padding-top: -10%;
		padding: 0;
		margin: 0;
		padding-left: 1.5rem;
		margin-bottom:4vh;
	}

	.home-portfolio .btn-secondary {
		grid-area: link;
		padding-right: 2rem;
	}


	.btn{
		display:inline-flex;
		padding: 15px 25px;
		border-radius: 15px;
		font-size: 15px;
		font-weight: 600;
		text-decoration: none;
		cursor: pointer;
        text-transform: uppercase;
	}


	.btn-secondary{
		background: transparent;
		color: #A38C95;
        font-weight: 400;
        text-decoration: underline;
        text-underline-offset: 6px;
		text-align: right;
	}

	.fan-item {
		transform: rotate(var(--rotate, 0deg)) translateY(var(--lift, 0px));;
		transform-origin: bottom center;
		transition: transform 0.3s ease;
		
	}


	.home-portfolio :global(.tool-card-placeholder),
	.home-portfolio :global(.tool-card-selected) {
		grid-area: cards;
		height: 50vh;
		min-width: 0;
    	max-width: 100%;
		
    }

	:global(.tool-card-selected) :global(.carousel-track) {
	    padding-bottom: 4vh;
	}
	
	.home-portfolio :global(.tool-card-selected) {
		grid-area: cards;
        display: none;
		z-index: 1; 
    }

	.home-portfolio :global(.home-softwareChips) {
        grid-area: chips;
		height: 13vh;
		min-width: 0;
    	max-width: 100%;
		margin-top: -1vh;
		z-index: 2; 
    }

	.home-portfolio :global(.home-chips-band) {
		grid-area: chips; 
		align-self: center;
		justify-self: center;

		width: 100%; 
		height: 35%;
		mix-blend-mode: multiply;
		mask-image: linear-gradient(to right, 
									transparent 20%, 
									black 40%, 
									black 60%, 
									transparent 80%);
		background: #BA4964;
		opacity: 0.5;
		z-index: 0;  
		pointer-events: none;
	}


	/* -------------------------------------------------------------- */ 
	/* ----------------------- CREDITS CONFIG ----------------------- */ 
	/* -------------------------------------------------------------- */ 
	.home-credits .home-title {
		bottom: 75%;
		margin-bottom: 0.1em;
	}



	/* -------------------------------------------------------------- */ 
	/* ------------------- PHONE MODIFICATIONS ---------------------- */ 
	/* -------------------------------------------------------------- */ 
	

	@media (orientation: portrait), (max-aspect-ratio: 9/16) {
		
		.home-hero {
			min-height: 86vh;
		}
		
		.home-hero::before {
			filter: blur(1.6px) brightness(0.7);
		}

		.home-ribbon{
			top: 83vh;
			transform: rotate(-5deg);
		}


		.home-portfolio-container {
			
			height: 85vh;
		}


		.home-portfolio .home-title {
			font-size: 6vh;
			letter-spacing: 5px;
			text-shadow: 
				-2px -2px 0 #050304,  
				2px -2px 0 #050304,
				-4px  4px 0 #050304,
				4px  4px 0 #050304;
		}

		.home-portfolio .home-subhead {
			font-size: 18px;
			margin-bottom: 1vh;
		}

		.fan-item {
			transform: none;
		}


		.home-title {
			font-size: 6.5vh;
		}


	}

</style>


<script>


	let selectedToolId: string;
	let changedPlaceholder = false;
	let cardsLimit = 4;


	window.addEventListener("tool:selected", (e) => {
		const { id } = (e as CustomEvent).detail;
		selectedToolId = id;

		const allCards = Array.from(document.querySelectorAll<HTMLElement>('.tool-card')).filter(c => c.dataset.software);
		const matching = allCards.filter(c => c.dataset.software === id);
		const rest = allCards.filter(c => c.dataset.software !== id);

		// Hide non-matching cards
		rest.forEach(c => {
			const fanItem = c.closest('.fan-item') as HTMLElement | null;
    		if (fanItem) fanItem.style.display = 'none';
			c.dataset.state = 'hidden';
		});

		function revealMatching() {
			const selected = document.querySelector('.tool-card-selected') as HTMLElement;
			selected.style.display = 'flex';

			const visible = matching.slice(0, cardsLimit);
    		const mid = (visible.length - 1) / 2;

			matching.forEach((c, i) => {
				const isVisible = i < cardsLimit;
    			const fanItem = c.closest('.fan-item') as HTMLElement | null;

				if (fanItem) fanItem.style.display = isVisible ? '' : 'none';
				c.style.setProperty('--card-index', String(i));


				if (isVisible && fanItem) {
					const offset = i - mid;
					const rotate = offset * 3;
					const lift = Math.pow(offset, 2) * 10;
					fanItem.style.setProperty('--rotate', `${rotate}deg`);
					fanItem.style.setProperty('--lift', `${lift}px`);
					
				}

				setTimeout(() => {
					c.dataset.state = i < cardsLimit ? 'active' : 'hidden';
				}, i * 300);
			});

			const selectedTrack = document.querySelector('.tool-card-selected [data-carousel]') as HTMLElement;
			if (selectedTrack) {
				selectedTrack.scrollLeft = 0;
			}

			requestAnimationFrame(() => requestAnimationFrame(() => {
				document.querySelectorAll<HTMLElement>('[data-carousel]').forEach(track => {
					track.dispatchEvent(new Event('scroll'));
				});
			}));
		}

		if (selectedToolId && !changedPlaceholder) {
			const placeholder = document.querySelector('.tool-card-placeholder') as HTMLElement;
			const PLACEHOLDER_OUT_MS = 200;

			if (placeholder) {
				placeholder.style.animation = 'cardOut 0.5s cubic-bezier(0.22, 1, 0.36, 1) forwards';
				setTimeout(() => {
					placeholder.style.display = 'none';
					revealMatching();
				}, PLACEHOLDER_OUT_MS);
			} else {
				revealMatching();
			}

			changedPlaceholder = true;
		} else {
			revealMatching();
		}
	});
</script>