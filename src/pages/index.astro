---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE, DEMOREEL } from '../consts';
import "../styles/animations.css";

import Vignette from '../components/widgets/Vignette.astro';
import HorizontalCarousel from '../components/widgets/HorizontalCarousel.astro';
import HomeRibbon from '../components/props/HomeRibbon.astro';
import SoftwareChip from '../components/props/SoftwareChip.astro';
import ToolCard from '../components/cards/ToolCard.astro';
import CreditCard from '../components/cards/CreditCard.astro';

import HomeHero from '../components/pages/home-hero.astro';

import { creditLibrary } from '../data/CreditsLibrary';
import { getActiveTools } from '../data/ToolLibrary';
const activeTools = getActiveTools();


import { getCollection } from 'astro:content';
const toolEntries = (await getCollection('tool'))
    .filter(entry => entry.data.featured)
    .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());


const lastCredits = [...creditLibrary]
	.sort((a, b) => b.year - a.year)
	.slice(0, 3);

---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header showThemeToggle={true}/>
		
		<div class="home-container">
			<main>
				<div class="overlap-group">
					<section class="home-hero">
						<HomeHero/>
					</section>
					<div class="home-ribbon">
						<HomeRibbon/>
					</div>
					
				
					<div class="rest">
						<section class="home-portfolio">
							<a class="home-title">MY TOOLS</a>
							<HorizontalCarousel class="tool-card-placeholder" itemSize='34vh' gap={2} navigation='buttons' buttonPosition="top" buttonJustify='right'>
								<ToolCard index={0} variant="full" />
							</HorizontalCarousel>
							<HorizontalCarousel class="tool-card-selected" itemSize='34vh' gap={2} navigation="buttons" buttonPosition="top" buttonJustify='right'>
								{toolEntries.map((entry, i) => (
									<ToolCard entry={entry} index={i} variant="full" />
								))}
							</HorizontalCarousel>

							<HorizontalCarousel class="home-softwareChips" itemSize='11vh' gap={1}>
								{activeTools.map(tool => <SoftwareChip tool={tool} />)}
							</HorizontalCarousel>

						</section>
						<section class="home-credits">
							<a class="home-title">LAST CREDITS</a>
							<HorizontalCarousel itemSize='34vh' gap={2} navigation='buttons' buttonPosition="top" buttonJustify='right'>
								{lastCredits.map((credit, i) => (
									<CreditCard entry={credit} index={i} variant="full" />
								))}
							</HorizontalCarousel>
						</section>
						<section class="home-ending">


						</section>
					</div>
				</div>
				
			</main>
		</div>
		<Footer class="home-social"/>
		<Vignette />
	</body>
</html>


<style> 

	body {
		-webkit-tap-highlight-color: transparent;
		-webkit-user-drag: none;
		-webkit-touch-callout: none;
		-webkit-user-select: none;
	}

	html, body {
		overflow-x: clip;
		width: 100%;
	}

	:root {
        --home-title: #ceccc9;
    }
	


	/* -------------------------------------------------------------- */ 
	/* ---------------------- MAIN SECTIONS ------------------------- */ 
	/* -------------------------------------------------------------- */ 
	.home-container::before {
		content: "";
		position: absolute;
		inset: 0;
		transform: scale(1.005);
		z-index: -1;
	}


	


	.home-title {
		position: absolute;
        color: var(--home-title); 
		font-family: 'Citylight';
		font-weight: 700;
  		font-style: normal;
		font-stretch: condensed;
        font-size: 9vh;
		
		filter: opacity(100%) drop-shadow(0 0 7px var(--color-primary-glow));
		user-select: none;
		
	}

	.overlap-group {
		position: relative;
		isolation: isolate;
	}

	.home-hero {
        position: sticky;
        top: 0;
        z-index: 1;
        min-height: 89vh;
        overflow: hidden;
		display: flex;
        align-items: center;
        justify-content: center;
    }


    .home-hero::before {
        content: "";
        position: absolute;
        inset: 0;
        background-image: url('../assets/BG/BG_MainHome_High_Home_v01.jpg');
        background-repeat: no-repeat;
        background-size: cover;
        background-position: top center;
        filter: blur(1.6px) brightness(1);
        transform: scale(1.0);
        z-index: -1;
    }

	.home-ribbon{
		position: absolute;
		top: 86vh;
		left: 0.1%;
		width: 100%;
		height: 5.4vh;
		overflow: hidden;
		z-index: 10;
		display: flex;
		align-items: center;
		transform: rotate(-1.3deg);
	}
	

	.rest {
		position: relative;
		z-index: 2;
		background-image: url('../assets/BG/BG_MainHome_High_Sections_v01.jpg');
		background-repeat: no-repeat;
		background-size: cover;
		background-position: top center;
		
		clip-path: polygon(0 2.3%, 100% 0, 100% 100%, 0 100%);
    	margin-top: -3.5vh;
	}

	.home-portfolio {
		position: relative;
		min-height: 100vh;
		width: 100%;
		/*background-color: rgba(72, 255, 0, 0.13);*/

		display: flex;
		flex-direction: column;
		justify-content: center;
		align-items: center;
	}

	.home-credits {
		position: relative;
		min-height: 100vh;
		width: 100%;

		display: flex;
		flex-direction: column;
		justify-content: center;
		align-items: center;
	}

	.home-ending {
		position: relative;
		min-height: 48vh;
		width: 100%;
	}

	section {
		display: block;
		scroll-snap-align: start;
	}


	body {
		margin: 0;
		padding: 0;
	}

	main {
		width: 100%;
		max-width: 100%;
		margin: 0;
		padding: 0;
	}


	.home-portfolio {
		display: flex;
		flex-direction: column;
	}

	
	.home-portfolio .home-title {
		bottom: 75%;
		margin-bottom: 0.1em;
	}

	

	.home-portfolio :global(.home-softwareChips) {
        position: absolute;
        bottom: 10%;
		z-index: 1;
    }

	.home-portfolio :global(.tool-card-placeholder),
	.home-portfolio :global(.tool-card-selected) {
        position: absolute;
        bottom: 28%;
		z-index: 3;
    }
	
	.home-portfolio :global(.tool-card-selected) {
        display: none;
    }

	/* -------------------------------------------------------------- */ 
	/* ----------------------- CREDITS CONFIG ----------------------- */ 
	/* -------------------------------------------------------------- */ 
	.home-credits .home-title {
		bottom: 75%;
		margin-bottom: 0.1em;
	}



	/* -------------------------------------------------------------- */ 
	/* ------------------- PHONE MODIFICATIONS ---------------------- */ 
	/* -------------------------------------------------------------- */ 
	

	@media (orientation: portrait), (max-aspect-ratio: 9/16) {
		.home-hero {
			min-height: 86vh;
		}
		
		.home-hero::before {
			filter: blur(1.6px) brightness(0.7);
		}

		.home-ribbon{
			top: 83vh;
			transform: rotate(-5deg);
		}


		.home-social { display: none; }

		.home-portfolio :global(.home-softwareChips) {
			bottom: 14%;
		}

		.home-portfolio :global(.tool-card-placeholder),
		.home-portfolio :global(.tool-card-selected) {
			bottom: 31%;
		}

		.home-title {
			font-size: 6.5vh;
		}

		.home-portfolio .home-title {
			bottom: 78.5%;
		}
		

	}

</style>


<script>


	let selectedToolId: string;
	let changedPlaceholder = false;
	let cardsLimit = 4;


	window.addEventListener("tool:selected", (e) => {
		const { id } = (e as CustomEvent).detail;
		selectedToolId = id;

		const allCards = Array.from(document.querySelectorAll<HTMLElement>('.tool-card')).filter(c => c.dataset.software);
		const matching = allCards.filter(c => c.dataset.software === id);
		const rest = allCards.filter(c => c.dataset.software !== id);

		// Hide non-matching cards
		rest.forEach(c => {
			c.style.display = 'none';
			c.dataset.state = 'hidden';
		});

		function revealMatching() {
			const selected = document.querySelector('.tool-card-selected') as HTMLElement;
			selected.style.display = 'flex';

			matching.forEach((c, i) => {
				c.style.display = i < cardsLimit ? '' : 'none';
				c.style.setProperty('--card-index', String(i));

				setTimeout(() => {
					c.dataset.state = i < cardsLimit ? 'active' : 'hidden';
				}, i * 300);
			});

			const selectedTrack = document.querySelector('.tool-card-selected [data-carousel]') as HTMLElement;
			if (selectedTrack) {
				selectedTrack.scrollLeft = 0;
			}

			requestAnimationFrame(() => requestAnimationFrame(() => {
				document.querySelectorAll<HTMLElement>('[data-carousel]').forEach(track => {
					track.dispatchEvent(new Event('scroll'));
				});
			}));
		}

		if (selectedToolId && !changedPlaceholder) {
			const placeholder = document.querySelector('.tool-card-placeholder') as HTMLElement;
			const PLACEHOLDER_OUT_MS = 200;

			if (placeholder) {
				placeholder.style.animation = 'cardOut 0.5s cubic-bezier(0.22, 1, 0.36, 1) forwards';
				setTimeout(() => {
					placeholder.style.display = 'none';
					revealMatching();
				}, PLACEHOLDER_OUT_MS);
			} else {
				revealMatching();
			}

			changedPlaceholder = true;
		} else {
			revealMatching();
		}
	});
</script>