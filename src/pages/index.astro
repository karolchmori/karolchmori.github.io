---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE, DEMOREEL } from '../consts';
import "../styles/animations.css";

import Vignette from '../components/widgets/Vignette.astro';
import HorizontalCarousel from '../components/widgets/HorizontalCarousel.astro';
import HomeRibbon from '../components/props/HomeRibbon.astro';
import CreditCard from '../components/cards/CreditCard.astro';

import HomeHero from '../components/pages/home-hero.astro';
import HomePortfolio from '../components/pages/home-portfolio.astro';

import { creditLibrary } from '../data/CreditsLibrary';



const lastCredits = [...creditLibrary]
	.sort((a, b) => b.year - a.year)
	.slice(0, 3);

---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header showThemeToggle={false}/>
		
		<div class="home-container">
			<main>
				<div class="overlap-group">
					<section class="home-hero">
						<HomeHero/>
					</section>
					<div class="home-ribbon">
						<HomeRibbon/>
					</div>
					
				
					<div class="rest">
						<section class="home-portfolio">
							<HomePortfolio/>
						</section>
						<section class="home-blog">
							<div class="home-blog-container">
								<p class="home-blog-text">I'm into computer graphics and the math behind it — I write about it on the blog.</p>
  								<a href="/blog" class="home-blog-btn">Explore more</a>
							</div>
						</section>

						<section class="home-credits">
							<div class="home-credits-container">
								<span class="home-title">LAST CREDITS</span>
								<HorizontalCarousel itemSize='34vh' gap={2} navigation='buttons' buttonPosition="top" buttonJustify='right'>
									{lastCredits.map((credit, i) => (
										<CreditCard entry={credit} index={i} variant="full" />
									))}
								</HorizontalCarousel>
							</div>
							
						</section>
						<section class="home-ending">


						</section>
					</div>
				</div>
				
			</main>
		</div>
		<Footer/>
		<Vignette />
	</body>
</html>


<style> 

	body {
		-webkit-tap-highlight-color: transparent;
		-webkit-user-drag: none;
		-webkit-touch-callout: none;
		-webkit-user-select: none;
	}


	:root {
        --home-title: #BDAEB2;
    }
	


	/* -------------------------------------------------------------- */ 
	/* ---------------------- MAIN SECTIONS ------------------------- */ 
	/* -------------------------------------------------------------- */ 
	.home-container::before {
		content: "";
		position: absolute;
		inset: 0;
		transform: scale(1);
		z-index: -1;
		
	}

	.home-container{
		width: 100%;
	}
	


	.home-title {
		
        color: var(--home-title); 
		font-family: 'Barqen', sans-serif;
		text-transform: uppercase;
		font-weight: 700;
		letter-spacing: 4px;
		user-select: none;
		
	}

	.overlap-group {
		position: relative;
		isolation: isolate;
	}

	.home-hero {
        position: sticky;
        top: 0;
        z-index: 1;
        min-height: 89vh;
        overflow: hidden;
		display: flex;
        align-items: center;
        justify-content: center;
		
    }


    .home-hero::before {
        content: "";
        position: absolute;
        inset: 0;
        background-image: url('../assets/BG/BG_MainHome_High_Home_v01.jpg');
        background-repeat: no-repeat;
        background-size: cover;
        background-position: top center;
        filter: blur(1.6px) brightness(1);
        transform: scale(1.0);
        z-index: -1;
    }

	.home-ribbon{
		position: absolute;
		top: 86vh;
		left: 0.1%;
		width: 100%;
		height: 5.4vh;
		overflow: hidden;
		z-index: 10;
		display: flex;
		align-items: center;
		transform: rotate(-1.3deg);
		box-sizing: border-box;
	}


	.rest {
		position: relative;
		z-index: 2;
		background-image: url('../assets/BG/BG_MainHome_High_Sections_v01.jpg');
		background-repeat: no-repeat;
		background-size: cover;
		background-position: top center;
		
		clip-path: polygon(0 2.3%, 100% 0, 100% 100%, 0 100%);
    	margin-top: -3.5vh;
	}



	.home-credits {
		position: relative;
		min-height: 80vh;

		display: flex;
		flex-direction: column;
		justify-content: center;
		align-items: center;

	}

	.home-credits-container{
		height: 70vh;
	}

	.home-ending {
		position: relative;
		min-height: 48vh;
	}

	section {
		display: block;
		scroll-snap-align: start;
	}


	body {
		margin: 0;
		padding: 0;
	}

	main {
		width: 100%;
		max-width: 100%;
		margin: 0;
		padding: 0;
	}

	.home-portfolio {
		position: relative;
		display: flex;
        align-items: center;
        justify-content: center;
		margin-bottom: 6vh;
	}

	

	.home-blog-container {
		background-color: #0e080a8c;
		padding: 28px 40px;
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 90px;
		flex-wrap: wrap;
	}
	

	.home-blog-text {
		margin: 0;
		font-size: 19px;
		font-weight: 300;
		color: #C0B1B5;
		text-align: center;
	}

	.home-blog-btn {
		background-color: #BA4964;
		color: #ece5d4;
		border: none;
		padding: 8px 30px;
		border-radius: 6px;
		font-size: 16px;
		font-weight: 500;
		letter-spacing: 0.5px;
		text-decoration: none;
		cursor: pointer;
		white-space: nowrap;
	}

	.home-blog-btn:hover {
		opacity: 0.9;
	}




	/* -------------------------------------------------------------- */ 
	/* ----------------------- CREDITS CONFIG ----------------------- */ 
	/* -------------------------------------------------------------- */ 
	.home-credits .home-title {
		bottom: 75%;
		margin-bottom: 0.1em;
	}



	/* -------------------------------------------------------------- */ 
	/* ------------------- PHONE MODIFICATIONS ---------------------- */ 
	/* -------------------------------------------------------------- */ 
	

	@media (orientation: portrait), (max-aspect-ratio: 9/16) {
		
		.home-hero {
			min-height: 86vh;
		}
		
		.home-hero::before {
			filter: blur(1.6px) brightness(0.7);
		}

		.home-ribbon{
			top: 83vh;
			transform: rotate(-5deg);
		}

		.home-blog-container {
			padding: 22px 40px;
			gap: 11px;
		}

		.home-blog-text {
			font-size: 17px;
		}

		.home-blog-btn {
			font-size: 14px;
		}


		.home-title {
			font-size: 6.5vh;
		}


	}

</style>


