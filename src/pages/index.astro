---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE, DEMOREEL } from '../consts';
import "../styles/animations.css";

import Vignette from '../components/widgets/Vignette.astro';
import HorizontalCarousel from '../components/widgets/HorizontalCarousel.astro';
import HomeRibbon from '../components/props/HomeRibbon.astro';
import CreditCard from '../components/cards/CreditCard.astro';

import HomeHero from '../components/pages/home-hero.astro';
import HomePortfolio from '../components/pages/home-portfolio.astro';

import { creditLibrary } from '../data/CreditsLibrary';



const lastCredits = [...creditLibrary]
	.sort((a, b) => b.year - a.year)
	.slice(0, 3);

const layouts = [
	{ drop: 9,  rot: -1.5 },
	{ drop: 24, rot: 0 },
	{ drop: 14,  rot: 1 },
];
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header showThemeToggle={false}/>
		
		<div class="home-container">
			<main>
				<div class="overlap-group">
					<section class="home-hero">
						<HomeHero/>
					</section>
					<div class="home-ribbon">
						<HomeRibbon/>
					</div>
					
				
					<div class="rest">
						<section class="home-portfolio">
							<HomePortfolio/>
						</section>
						<section class="home-blog">
							<div class="home-blog-container">
								<p class="home-blog-text">I'm into computer graphics and the math behind it — I write about it on the blog.</p>
  								<a href="/blog" class="home-blog-btn">Explore more</a>
							</div>
						</section>

						<section class="home-credits">
							<div class="home-credits-container">
								<div class="credits-intro">
									<span class="home-title">Recent Credits</span>
									<p class="credits-text">Studios and productions I've been part of.</p>
									<a href="/credits" class="home-blog-btn">All credits</a>
								</div>
								<div class="credits-board">
									{lastCredits.map((credit, i) => {
										const l = layouts[i % layouts.length];
										return (
											<div
												class="credit-slot"
												style={`--drop:${l.drop}em; --rot:${l.rot}deg; --m-rot:${i % 2 === 0 ? -2.5 : 2.5}deg; --m-shift:${i % 2 === 0 ? -6 : 6}px`}
											>
												<CreditCard entry={credit} index={i} variant="full" />
											</div>
										);
									})}
								</div>
							</div>
							
						</section>
						<section class="home-ending">


						</section>
					</div>
				</div>
				
			</main>
		</div>
		<Footer/>
		<Vignette />
	</body>
</html>


<style> 

	body {
		-webkit-tap-highlight-color: transparent;
		-webkit-user-drag: none;
		-webkit-touch-callout: none;
		-webkit-user-select: none;
	}


	:root {
        --home-title: #BDAEB2;
    }
	


	/* -------------------------------------------------------------- */ 
	/* ---------------------- MAIN SECTIONS ------------------------- */ 
	/* -------------------------------------------------------------- */ 
	.home-container::before {
		content: "";
		position: absolute;
		inset: 0;
		transform: scale(1);
		z-index: -1;
		
	}

	.home-container{
		width: 100%;
	}
	


	.home-title {
        color: var(--home-title); 
		font-family: 'Barqen', sans-serif;
		text-transform: uppercase;
		font-weight: 700;
		letter-spacing: 4px;
		user-select: none;
	}


	.overlap-group {
		position: relative;
		isolation: isolate;
	}

	.home-hero {
        position: sticky;
        top: 0;
        z-index: 1;
        min-height: 89vh;
        overflow: hidden;
		display: flex;
        align-items: center;
        justify-content: center;
		
    }


    .home-hero::before {
        content: "";
        position: absolute;
        inset: 0;
        background-image: url('../assets/BG/BG_MainHome_High_Home_v01.jpg');
        background-repeat: no-repeat;
        background-size: cover;
        background-position: top center;
        filter: blur(1.6px) brightness(1);
        transform: scale(1.0);
        z-index: -1;
    }

	.home-ribbon{
		position: absolute;
		top: 86vh;
		left: 0.1%;
		width: 100%;
		height: 5.4vh;
		overflow: hidden;
		z-index: 10;
		display: flex;
		align-items: center;
		transform: rotate(-1.3deg);
		box-sizing: border-box;
	}


	.rest {
		position: relative;
		z-index: 2;
		background-image: url('../assets/BG/BG_MainHome_High_Sections_v01.jpg');
		background-repeat: no-repeat;
		background-size: cover;
		background-position: top center;
		
		clip-path: polygon(0 2.3%, 100% 0, 100% 100%, 0 100%);
    	margin-top: -3.5vh;
	}



	.home-credits {
		position: relative;
		min-height: 70vh;
		padding: 0;
		display: flex;
		flex-direction: column;
		align-items: center;
	}

	.home-credits-container {
		width: 100%;
		max-width: 1400px;
		padding-inline: 3vw;
		box-sizing: border-box;
		display: grid;
		grid-template-columns: minmax(260px, 28%) 1fr;
		align-items: start;
	}

	.credits-intro {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: 0.9rem;
		text-align: left;
		padding-top: 16vh;
	}

	.credits-text {
		margin: 0;
		font-size: 17px;
		font-weight: 300;
		color: #C0B1B5;
	}

	.credits-board {
		--slot-w: clamp(170px, 14vw, 240px);
		display: flex;
		flex-direction: row;
		justify-content: center;
		align-items: flex-start;
		gap: 40px; 
		width: 100%;
	}

	.credit-slot {
		position: relative;
		flex: none;
		width: var(--slot-w);
		margin-top: var(--drop);
		/* swing from the point where the strap meets the ceiling */
		transform-origin: 50% calc(0px - var(--drop));
		transform: rotate(var(--rot));
	}

	/* the lanyard */
	.credit-slot::before {
		content: "";
		position: absolute;
		bottom: 100%;
		left: 46.5%;
		width: 1.1rem;
		height: var(--drop);
		border-radius: 2px;
		background: linear-gradient(to bottom, transparent 0%, #6b5a60 70%);
	}
	

	.home-ending {
		position: relative;
		min-height: 58vh;
	}

	section {
		display: block;
		scroll-snap-align: start;
	}


	body {
		margin: 0;
		padding: 0;
	}

	main {
		width: 100%;
		max-width: 100%;
		margin: 0;
		padding: 0;
	}

	.home-portfolio {
		position: relative;
		display: flex;
        align-items: center;
        justify-content: center;
		margin-bottom: 6vh;
	}

	

	.home-blog-container {
		background-color: #0e080a8c;
		padding: 28px 40px;
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 90px;
		flex-wrap: wrap;
	}
	

	.home-blog-text {
		margin: 0;
		font-size: 19px;
		font-weight: 300;
		color: #C0B1B5;
		text-align: center;
	}

	.home-blog-btn {
		background-color: #BA4964;
		color: #ece5d4;
		border: none;
		padding: 8px 30px;
		border-radius: 6px;
		font-size: 16px;
		font-weight: 500;
		letter-spacing: 0.5px;
		text-decoration: none;
		cursor: pointer;
		white-space: nowrap;
	}

	.home-blog-btn:hover {
		opacity: 0.9;
	}




	/* -------------------------------------------------------------- */ 
	/* ----------------------- CREDITS CONFIG ----------------------- */ 
	/* -------------------------------------------------------------- */ 
	.home-credits .home-title {
		bottom: 75%;
		margin-bottom: 0.1em;
	}



	/* -------------------------------------------------------------- */ 
	/* ------------------- PHONE MODIFICATIONS ---------------------- */ 
	/* -------------------------------------------------------------- */ 
	

	@media (orientation: portrait), (max-aspect-ratio: 9/16) {
		
		.home-hero {
			min-height: 86vh;
		}
		
		.home-hero::before {
			filter: blur(1.6px) brightness(0.7);
		}

		.home-ribbon{
			top: 83vh;
			transform: rotate(-5deg);
		}

		.home-blog-container {
			padding: 22px 40px;
			gap: 11px;
		}

		.home-blog-text {
			font-size: 17px;
		}

		.home-blog-btn {
			font-size: 14px;
		}


		.home-title {
			font-size: 6.5vh;
		}

		
		.home-credits {
			padding: 6vh 0 8vh;
		}

		.home-credits-container {
			display: flex;
			flex-direction: column;
			align-items: center;
			gap: 3rem;
		}

		.credits-intro {
			align-items: center;
			text-align: center;
			padding-top: 0;
		}

		.credits-board {
			flex-direction: column;
			justify-content: flex-start;
			align-items: center;
			gap: 3.5rem;
		}

		.credit-slot {
			width: min(78vw, 300px);
			margin-top: 0;
			transform-origin: center;
			transform: translateX(var(--m-shift)) rotate(var(--m-rot));
		}

		.credit-slot::before {
			display: none;
		}


	}

</style>


