---
// About.astro
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import Vignette from '../components/widgets/Vignette.astro';

import MyPicture from '../assets/me.jpg';


import SkillsGroup from '../components/props/SkillsGroup.astro';
import LanguageGrid from '../components/props/LanguageGrid.astro';
import { SITE_DESCRIPTION, SITE_TITLE, DEMOREEL } from '../consts';

import { VideoEmbed, Collapsible, Callout, CodeBlock, PictureCompare, 
    DynamicTable, IconList, PictureSequence, Columns, Column, TimelineItem, Timeline, Picture, VideoPlayer
 } from '../components/mdx-components';

import Icon from '../components/widgets/Icon.astro';

---
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>	
	<body>
		<Header />
		<div class="about-container">
			<main>
				<section class="about-page">
					<div class="about-banner">
						<Columns stackOnMobile>
							<Column width='75%'>
								<h2 class="about-title">Technical Artist</h2>
								<p class="about-bio">
									I'm Technical Artist focused in Tools and Pipeline with a background in technical project management.
									I build the tools and systems that keep artists and productions moving — from 
									procedural Houdini setups to the publish pipelines around them. Comfortable
									moving between DCC scripting and the production side of a studio.
								</p>
								<div class="about-actions">
									<a href="mailto:karolchmori@hotmail.com" class="about-btn about-btn-primary">Get in touch</a>
									<a href="/KarolChMori_CV.pdf" class="about-btn about-btn-secondary" download>
										<Icon class="about-btn-icon" name="download" size={16}/>
										CV
									</a>
								</div>
							</Column>
							<Column>
								<div class="about-photo">
									<img src={MyPicture.src} alt="" />
								</div>
							</Column>
						</Columns>
					</div>

					<!-- LIGHT CONTENT BELOW -->
					<div class="prose">

						<!-- SKILLS -->
						<div class="section-label">Specialities</div>
						<IconList defaultIcon='dot' 
							items={[
							{ text: "**Tools Development:** Python and C++ tooling for artists: custom DCCs, shelf tools, validators, and procedural systems.", iconColor: "var(--page-primary)"},
							{ text: "**Pipeline TD:** End-to-end pipeline design and automation. Asset management, publish systems, and cross-DCC interop for film, TV, and games.", iconColor: "var(--page-primary)"},
							{ text: "**Project Management**: Production planning, team coordination and technical roadmaps. Keeping creative teams unblocked and shipping on time.", iconColor: "var(--page-primary)"},
							]}
						/>

						<div class="divider"></div>

						<!-- SKILLS & SOFTWARE-->
						<div class="section-label">Skills &amp; Software</div>
						<Columns stackOnMobile>
							<Column>
								<SkillsGroup title='Programming & Scripting' items={['Python','C++','VEX','C#','Java','Dart']} accent={1} />
								<SkillsGroup title='DCC & Creative Tools' items={['Houdini','Maya','Nuke','Substance Painter','Unreal Engine','Photoshop']} accent={3} />
							</Column>
							<Column>
								<SkillsGroup title='Pipeline & Tools' items={['USD','Git','GitHub','Qt','PySide']} accent={1} />
								<SkillsGroup title='Production & PM' items={['ShotGrid', 'Jira', 'Notion','Confluence','Agile','Scrum']} accent={0} />
							</Column>
						</Columns>

						<div class="divider"></div>
						<div class="section-label">Work Experience</div>
						<Timeline>
							<TimelineItem current
								title="Technical Project Manager"
								sub="Esteve Teijin · 2021 - Present"
								brief="Leading cross-functional delivery for internal tooling."
								detail="Longer writeup here."
							/>
							<TimelineItem
								title="IT Help Desk"
								sub="Esteve Teijin · 2020 - 2021"
								brief="First-line technical support across the org."
							/>
						</Timeline>
						
						<!-- LANGUAGES -->
						<div class="divider"></div>
						<div class="section-label">Languages</div>
						<LanguageGrid languages={[
							{ name: 'Spanish', level: 'Native' },
							{ name: 'English', level: 'Fluent' },
							{ name: 'Catalan', level: 'Fluent' },
							{ name: 'Japanese', level: 'Elementary' },
						]} />


						<div class="divider"></div>
						<div class="section-label">Education</div>
						<Timeline>
							<TimelineItem current
								title="Technical Project Manager"
								sub="Esteve Teijin · 2021 - Present"
								brief="Leading cross-functional delivery for internal tooling."
								detail="Longer writeup here."
							/>
							<TimelineItem
								title="IT Help Desk"
								sub="Esteve Teijin · 2020 - 2021"
								brief="First-line technical support across the org."
							/>
						</Timeline>

					</div>

				</section>

			</main>
		</div>
		<Footer />
		<Vignette />
	</body>
</html>



<style>

	.about-container {
		position: relative;
		min-height: 100vh;      /* ← container itself must have a height to push against */
		display: flex;
		flex-direction: column;
	}

	.about-container::before {
		content: "";
		position: fixed;
		inset: 0;
		background-image: url('../assets/BG/BG_High.jpg');
		background-repeat: no-repeat;
		background-size: cover;
		background-position: top center;
		z-index: -1;
	}

	main {
		position: relative;
		z-index: 1;
		width: calc(100% - 2em);
		max-width: 100%;
		margin: 0 auto;
		flex: 1;                /* ← takes remaining space inside tool-container */
		display: flex;
		flex-direction: column;
	}
 

	.about-page {
		background-color: var(--page-mainbg);
		border-radius: 16px;
		max-width: 900px;
		width: 100%;
		margin: 1rem auto;
		overflow: hidden;
		flex: 1;     
		display: flex;
		flex-direction: column;
	}


	.prose :global(.icon-list-text strong) {
		color: var(--page-fourfont);
		font-weight: 700;
	}

	/* ── HERO ── */
	.about-banner {
		display: flex;
		align-items: center;
		justify-content: space-between;
		background: var(--page-secondarybg);
		padding: 0.5rem 2.5rem;
		margin: 0 0 1em;
	}


	.about-photo {
		flex-shrink: 0;
		display: flex;
		align-items: center;
		justify-content: center;
		height: 100%;
		padding-top: 1rem;
		padding-left: 1rem;
	}

	.about-photo img {
		width: 170px;
		height: 170px;
		border-radius: 10%;
		object-fit: cover;
		
	}
 
	.about-title{
		font-family: monospace;
		letter-spacing: 0.05rem;
		text-transform: uppercase;
		color: color-mix(in srgb, var(--page-primary) 85%, var(--page-secondarybg));
		margin-bottom: 0.9rem;
	}

	.about-actions {
		display: flex;
		gap: 0.65rem;
	}
 
	.about-btn {
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
		font-size: 0.82rem;
		font-weight: 600;
		padding: 0.5rem 0.9rem;
		border-radius: 8px;
		text-decoration: none;
		transition: opacity 0.15s ease, background 0.15s ease;
	}
 
	.about-btn-icon {
		width: 14px;
		height: 14px;
	}

	.about-btn-primary {
		background: color-mix(in srgb, var(--page-primary) 85%, var(--page-secondarybg));
		color: #fff;
		border: 1px solid var(--page-primary);
	}
 
	.about-btn-secondary {
		background: var(--page-secondarybg);
		border: 1px solid var(--page-border);
		color: var(--page-mainfont);
	}
 
 
	/* ── BIO ── */
	.about-bio {
		line-height: 1.5;
		color: var(--page-secondaryfont);
	}

	/* ── DIVIDER ── */
	.divider {
		height: 1px;
		background: var(--page-border);
		margin: 2rem 0;
	}
	
	/* ── SECTION LABEL ── */
	.section-label {
		font-family: monospace;
		font-size: 1rem;
		letter-spacing: 0.2em;
		text-transform: uppercase;
		color: var(--page-thirdfont);
		margin-bottom: 1.25rem;
	}

	/* ── MOBILE ── */
	@media (orientation: portrait), (max-aspect-ratio: 9/16) {

		.about-container {
			padding-top: 2em;
		}

		.about-banner {
			flex-direction: column;
			text-align: center;
			padding: 0.7rem 1.5rem 1rem;
		}

		.about-photo {
			padding-top: 2rem;
		}


		.banner-actions {
			justify-content: center;
		}
	}

</style>