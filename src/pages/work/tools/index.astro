---
// About.astro
import BaseHead from '../../../components/BaseHead.astro';
import Footer from '../../../components/Footer.astro';
import Header from '../../../components/Header.astro';
import Vignette from '../../../components/widgets/Vignette.astro';

import SkillsGroup from '../../../components/props/SkillsGroup.astro';
import LanguageGrid from '../../../components/props/LanguageGrid.astro';
import { SITE_DESCRIPTION, SITE_TITLE, DEMOREEL } from '../../../consts';

import { VideoEmbed, Collapsible, Callout, CodeBlock, PictureCompare, 
    DynamicTable, IconList, PictureSequence, Columns, Column, TimelineItem, Timeline, Picture, VideoPlayer
 } from '../../../components/mdx-components';

import Icon from '../../../components/widgets/Icon.astro';

import ToolsGrid from '../../../components/props/ToolsGrid.astro';
import { getCollection } from 'astro:content';

const tools = await getCollection('tool');
const sortedTools = tools.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());


---
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>	
	<body>
		<Header/>
        <div class="projects-container">
			<main>
				<section class="projects-page">
					<ToolsGrid entries={sortedTools} />
				</section>
				
			</main>
        </div>
        <Footer />
		<Vignette />
	</body>
</html>


<style>

	html {
		overflow-y: scroll;
	}

	.projects-container {
		position: relative;
		min-height: 100vh;      /* ← container itself must have a height to push against */
		display: flex;
		flex-direction: column;
	}

	.projects-container::before {
		content: "";
		position: fixed;
		inset: 0;
		background-image: url('../../../assets/BG/BG_High.jpg');
		background-repeat: no-repeat;
		background-size: cover;
		background-position: top center;
		z-index: -1;
	}

	main {
		position: relative;
		z-index: 1;
		width: calc(100% - 2em);
		max-width: 100%;
		margin: 0 auto;
		flex: 1;                /* ← takes remaining space inside tool-container */
		display: flex;
		flex-direction: column;
	}

	.projects-page {
		max-width: 1000px;
		width: 100%;
		margin: 1rem auto;
		overflow: hidden;
		flex: 1;     
		display: flex;
		flex-direction: column;
	}

	

	.prose :global(.icon-list-text strong) {
		color: var(--page-fourfont);
		font-weight: 700;
	}


	/* ── MOBILE ── */
	@media (orientation: portrait), (max-aspect-ratio: 9/16) {

		.projects-container {
			padding-top: 2em;
			padding-bottom: 2em;
		}

	}

</style>