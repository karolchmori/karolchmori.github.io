---
import HeaderLink from './HeaderLink.astro';

type Props = {
  label: string;
  href: string;
  children: { label: string; href: string }[];
};

const { label, href, children } = Astro.props;
const pathname = Astro.url.pathname.replace(import.meta.env.BASE_URL, '');
const subpath = pathname.match(/[^\/]+/g);
const isActive = href === pathname || href === '/' + (subpath?.[0] || '');
---


<div class:list={['dropdown', 'expanded', { active: isActive }]}>
    <div class="dropdown-trigger">
        <span class="nav-link">{label}</span>
        <button class="arrow-btn" aria-label="Toggle submenu">▾</button>
    </div>

    <div class="dropdown-menu">
        {children.map(child => (
            <HeaderLink href={child.href}>{child.label}</HeaderLink>
        ))}
    </div>

    <!-- Mobile -->
    <div class="mobile-children">
        {children.map(child => (
            <HeaderLink href={child.href}>{child.label}</HeaderLink>
        ))}
    </div>
</div>

<style>
    .dropdown {
        position: relative;
        display: inline-block;
    }

    .dropdown-trigger {
        display: inline-block;
        user-select: none;
        cursor: pointer;
    }

    .dropdown-trigger .nav-link {
        text-decoration: none;
        font-family: monospace;
        text-transform: uppercase;
        letter-spacing: 0.05rem;
        font-size: 14pt;
        color: var(--menu-title);
    }

    .dropdown-trigger:hover a.nav-link {
        color: var(--menu-accent);
        font-weight: 400;
    }

    .arrow-btn {
        background: none;
        border: none;
        outline: none;
        color: var(--menu-title);
        font-size: 1em;
        padding: 0 0em;
        cursor: pointer;
        transition: transform 0.2s ease;
        line-height: 1;
    }

    /* Desktop dropdown panel */
    .dropdown-menu {
        display: none;
        position: absolute;
        top: 100%;
        left: 0;
        background: #0C0A0D; /* explicit opaque color, matches your mobile menu bg */
        flex-direction: column;
        min-width: 6em;
        padding: 0.5rem 0.75rem;
        border-radius: 0 0 8px 8px;
        box-shadow: -5px 10px 25px rgba(0, 0, 0, 0.4);
        border-left: 1px solid rgba(255, 255, 255, 0.05);
        border-bottom: 1px solid rgba(255, 255, 255, 0.05);
        z-index: 999;
    }

    .dropdown:hover .dropdown-menu {
        display: flex;
    }


    /* Mobile children hidden on desktop */
    .mobile-children {
        display: none;
    }

    /* ---- Mobile ---- */
    @media (orientation: portrait), (max-aspect-ratio: 9/16) {
        .dropdown {
            display: flex;
            flex-direction: column;
            align-items: flex-end;
        }

    
        .dropdown-menu {
            display: none !important; 
        }

        .mobile-children {
            display: flex;
            flex-direction: column;
            align-items: flex-end;
            gap: 0.2rem; /* Matches your main menu vertical spacing */
        }

        /* Optional: Make Credits and Tools slightly smaller to look like nested sub-items */
        .mobile-children :global(.nav-link) {
            font-size: 0.9rem !important; 
            opacity: 0.85;
        }

        .dropdown.expanded .mobile-children {
            display: flex;
        }

        
    }


</style>

<script>
    document.querySelectorAll('.dropdown-trigger').forEach(trigger => {
        trigger.addEventListener('click', (e) => {
            
            if ((e.target as HTMLElement).closest('.arrow-btn')) return;
            const dropdown = trigger.closest('.dropdown');
            dropdown?.classList.toggle('expanded');
        });
    });
</script>