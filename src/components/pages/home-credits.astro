---
import CreditCard from '../cards/CreditCard.astro';
import { creditLibrary } from '../../data/CreditsLibrary';



const lastCredits = [...creditLibrary]
	.sort((a, b) => b.year - a.year)
	.slice(0, 3);

const layouts = [
	{ drop: 7,  rot: -1.5 },
	{ drop: 17, rot: 0 },
	{ drop: 12,  rot: 1 },
];

---




<div class="home-credits-container">
    <span class="home-title">Recent Credits</span>
    <p class="home-subhead">Projects and collaborations.
        <a href="/work/credits" class="btn btn-secondary">All credits</a>
    </p>
    <div class="credits-board">
        {lastCredits.map((credit, i) => {
            const l = layouts[i % layouts.length];
            return (
                <div
                    class="credit-slot"
                    style={`--drop:${l.drop}em; --rot:${l.rot}deg; --m-rot:${i % 2 === 0 ? -2.5 : 2.5}deg; --m-shift:${i % 2 === 0 ? -6 : 6}px`}
                >
                    <CreditCard entry={credit} index={i} variant="full" />
                </div>
            );
        })}
    </div>
</div>


<style>

    .home-credits-container {
        display: grid;
        align-items: start;
        grid-template-columns: 1fr 1.8fr;
        grid-template-rows: 1fr 1fr;
        grid-template-areas: 
        "header badges"
        "subhead badges";
        align-items: center;
        overflow: visible;
        height: 90vh;
        width: 100vw;
        max-width: 1800px;
        
    }


    .home-title {
        grid-area: header;
        user-select: none;
        color: #BA4964;
        font-size: 80px;
        line-height: 1.2;
        letter-spacing: 8px;
        display: inline-block;
        font-weight: 700;
        font-family: 'Barqen', sans-serif;
        text-transform: uppercase;
        text-shadow: 
            -4px -4px 0 #050304,  
            4px -4px 0 #050304,
            -8px  8px 0 #050304,
            8px  8px 0 #050304;

        align-self: end;
        justify-self: center;
        text-align: center;
    }

    
    .home-subhead {
        grid-area: subhead;
        font-size: 21px;
        color: #A38C95;
		line-height: 1;
		padding: 0;
		margin: 0;
        
        margin-top: -0.6rem;

        align-self: start;
        justify-self: center; 
    }

    .btn{
		display:inline-flex;
		padding: 15px 25px;
		border-radius: 15px;
		font-size: 15px;
		font-weight: 600;
		text-decoration: none;
		cursor: pointer;
        text-transform: uppercase;
	}

    .btn-secondary {
		background: transparent;
		color: #A38C95;
        font-weight: 400;
        text-decoration: underline;
        text-underline-offset: 6px;
		text-align: right;
        grid-area: link;
	}



    .credits-board {
        grid-area: badges;
        --slot-w: 32vh;
        display: flex;
        align-self: start;  
        justify-self: start;
        flex-direction: row;
        gap: 40px; 
        
    }

    .credit-slot {
        position: relative;
        flex: none;
        width: var(--slot-w);
        margin-top: var(--drop);
        transform-origin: 50% calc(0px - var(--drop));
        transform: rotate(var(--rot));
    }


    .credit-slot::before,
    .credit-slot::after {
        content: "";
        position: absolute;
        bottom: 100%;
        left: 46.5%;
        width: 2.1vh;
        height: var(--drop);
        border-radius: 2px;
        border: 1px solid rgba(0, 0, 0, 0.25);
 
        background:
            /* woven texture: a thin dark line every 8px */
            repeating-linear-gradient(
                to bottom,
                rgba(0, 0, 0, 0.28) 0px,
                rgba(0, 0, 0, 0.28) 1px,
                transparent 1px,
                transparent 8px
            ),
            /* soft edge shading so it reads as a flat strap */
            linear-gradient(
                to right,
                rgba(0, 0, 0, 0.25) 0%,
                transparent 18%,
                transparent 82%,
                rgba(0, 0, 0, 0.25) 100%
            ),
            /* base color */
            var(--strap-color);
 
        /* fade the top out */
        -webkit-mask-image: linear-gradient(to bottom, transparent 0%, #000 45%);
        mask-image: linear-gradient(to bottom, transparent 0%, #000 45%);
    }
    
    .credit-slot::before {
        --strap-color: #3c383c;
        z-index: -1;
    }
 
    /* shorter strap, tilted outward from the same point, sits in front of the straight one */
    .credit-slot::after {
        --strap-color: #2a2629;
        transform-origin: 50% 100%;
        transform: rotate(7deg);
        z-index: -2;
        opacity: 100%;
    }


    @media (orientation: portrait), (max-aspect-ratio: 9/16) {
        .home-credits-container {
			height: auto;
            grid-template-columns: 1fr;
            grid-template-rows: auto auto auto;
            grid-template-areas:
                "header"
                "subhead"
                "badges";
            row-gap: 1rem;
            align-items: center;
		}

		.home-title {
			font-size: 6vh;
			letter-spacing: 5px;
			text-shadow: 
				-2px -2px 0 #050304,  
				2px -2px 0 #050304,
				-4px  4px 0 #050304,
				4px  4px 0 #050304;
		}

        .home-subhead {
			font-size: 18px;
            margin-top: -1.5rem;
			margin-bottom: 0;
            padding-left: 0.7rem;
            display: flex;
            flex-direction: row; 
            align-items: center;
            justify-self: center; 
		}

        .btn{
            padding: 15px 15px;
        }


		.credits-board {
			justify-self: center;
            align-self: center;
            flex-direction: column;
            align-items: center;
            gap: 2rem;
		}

		.credit-slot {
			width: 70vw;
			margin-top: 0;
			transform-origin: center;
			transform: translateX(var(--m-shift)) rotate(var(--m-rot));
		}

        .credit-slot :global(.credit-card-clip) {
            display: none;
        }

		.credit-slot::before {
			display: none;
		}

    }


</style>