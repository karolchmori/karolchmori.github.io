---
import CreditCard from '../cards/CreditCard.astro';
import { creditLibrary } from '../../data/CreditsLibrary';



const lastCredits = [...creditLibrary]
	.sort((a, b) => b.year - a.year)
	.slice(0, 3);

const layouts = [
	{ drop: 9,  rot: -1.5 },
	{ drop: 24, rot: 0 },
	{ drop: 14,  rot: 1 },
];

---




<div class="home-credits-container">
    <div class="credits-intro">
        <span class="home-title">Recent Credits</span>
        <p class="credits-text">Studios and productions I've been part of.</p>
        <a href="/credits" class="home-blog-btn">All credits</a>
    </div>
    <div class="credits-board">
        {lastCredits.map((credit, i) => {
            const l = layouts[i % layouts.length];
            return (
                <div
                    class="credit-slot"
                    style={`--drop:${l.drop}em; --rot:${l.rot}deg; --m-rot:${i % 2 === 0 ? -2.5 : 2.5}deg; --m-shift:${i % 2 === 0 ? -6 : 6}px`}
                >
                    <CreditCard entry={credit} index={i} variant="full" />
                </div>
            );
        })}
    </div>
</div>


<style>


    .home-credits-container {
        width: 100vw;
        max-width: 1900px;
        height: 70vh;
        padding: 0;
        padding-inline: 3vw;
        box-sizing: border-box;
        display: grid;
        grid-template-columns: minmax(260px, 28%) 1fr;
        align-items: start;
        
    }

    .home-title {
        grid-area: header;
        user-select: none;
        color: #BA4964;
        font-size: 80px;
        line-height: 1.2;
        letter-spacing: 8px;
        display: inline-block;
        font-weight: 700;
        font-family: 'Barqen', sans-serif;
        text-transform: uppercase;
        text-shadow: 
            -4px -4px 0 #050304,  
                4px -4px 0 #050304,
            -8px  8px 0 #050304,
                8px  8px 0 #050304;

        
        padding-left: 1.5rem;
        justify-self: center;
        margin-bottom: -0.9rem;
    }

    .credits-intro {
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        gap: 0.9rem;
        text-align: left;
        padding-top: 16vh;
    }

    .credits-text {
        margin: 0;
        font-size: 17px;
        font-weight: 300;
        color: #C0B1B5;
    }

    .credits-board {
        --slot-w: 300px;
        display: flex;
        flex-direction: row;
        justify-content: center;
        align-items: flex-start;
        gap: 40px; 
        width: 100%;
    }

    .credit-slot {
        position: relative;
        flex: none;
        width: var(--slot-w);
        margin-top: var(--drop);
        transform-origin: 50% calc(0px - var(--drop));
        transform: rotate(var(--rot));
    }

    /* the lanyard */
    .credit-slot::before {
        content: "";
        position: absolute;
        bottom: 100%;
        left: 46.5%;
        width: 1.1rem;
        height: var(--drop);
        border-radius: 2px;
        background: linear-gradient(to bottom, transparent 0%, #6b5a60 70%);
    }
	


    @media (orientation: portrait), (max-aspect-ratio: 9/16) {
        .home-credits-container {
			display: flex;
			flex-direction: column;
			align-items: center;
			gap: 3rem;
		}

		.credits-intro {
			align-items: center;
			text-align: center;
			padding-top: 0;
		}

		.credits-board {
			flex-direction: column;
			justify-content: flex-start;
			align-items: center;
			gap: 3.5rem;
		}

		.credit-slot {
			width: min(78vw, 300px);
			margin-top: 0;
			transform-origin: center;
			transform: translateX(var(--m-shift)) rotate(var(--m-rot));
		}

		.credit-slot::before {
			display: none;
		}

    }


</style>