---
import CardA from '../../assets/icons/AS_CardA.svg';
import CardB from '../../assets/icons/AS_CardB.svg';
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import StackBadge from '../props/StackBadge.astro';
import Icon from '../widgets/Icon.astro';

interface Props {
    entry?: CollectionEntry<'tool'>;
    index?: number;
    variant?: 'full' | 'mini';
}

const { entry, index = 0, variant = 'full' } = Astro.props;

const title       = entry?.data.title       ?? "";
const description = entry?.data.description ?? "";
const thumbnail   = entry?.data.thumbnail   ?? null;
const software    = entry?.data.software    ?? "";
const filePath    = entry?.id               ?? null;
const stack       = entry?.data.stack       ?? [];
const department  = entry?.data.department  ?? [];
const slug        = entry?.data.title.toLowerCase().replace(/\s+/g, '-') ?? null;

const suits = ['club', 'heart', 'diamond', 'spade'] as const;
const ranks = ["2", "3", "4", "5", "6", "7", "8", "9", "J", "K", "A"];

const cardRank = ranks[Math.floor(Math.random() * ranks.length)];
const cardSuit = suits[Math.floor(Math.random() * suits.length)];
const isRed = cardSuit === 'heart' || cardSuit === 'diamond';

// "full" variant supports the empty/hidden placeholder states used in decks.
// "mini" variant is used for filtered grids and starts as "pending".
const initialState = variant === 'full'
    ? (entry ? "hidden" : "empty")
    : "pending";

const cardIcon = index % 2 !== 0 ? CardA : CardB;
---

<div
    class="tool-card"
    data-variant={variant}
    data-path={filePath}
    data-software={software}
    data-department={department.join(',')}
    data-stack={stack.join(',')}
    data-state={initialState}
    data-href={slug ? `/work/tools/${slug}` : null}
>
    {variant === 'full' && (
        <div class="tool-card-empty">
            <img src={cardIcon.src} alt="" />
        </div>
    )}

    <div class="tool-card-content">
        <div class="card-notch top-left" data-red={isRed}>
            <h1 class="rank">{cardRank}</h1>
            <Icon name={cardSuit} size="var(--notch-icon-size)" class="suit" />
        </div>

        <div class="tool-card-information">
            <div class="tool-card-thumbnail">
                {thumbnail
                    ? <Image src={thumbnail} alt={title} />
                    : <div class="tool-card-thumbnail-empty" />
                }
            </div>
            <div class="tool-card-body">
                <h4 class="tool-card-title">{title}</h4>
                <p class="tool-card-description">{description}</p>
                <div class="tool-card-stack">
                    {stack.map(tech => (
                        <StackBadge
                            name={tech}
                            backgroundcolor="color-mix(in srgb, var(--card-black) 85%, transparent)"
                            color="var(--tool-card-white)"
                            size="10cqi"
                        />
                    ))}
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    :root {
        --card-bg: var(--tool-card-bg);
        --card-pink: var(--tool-card-pink);
        --card-black: var(--tool-card-black);
        --card-white: var(--tool-card-white);
        --card-title: var(--tool-card-title);
    }

    /* ── Base (shared) ── */
    .tool-card {
        width: 100%;
        height: 100%;
        overflow: visible;
        transform-style: preserve-3d;
        border-radius: 16px;
        box-sizing: border-box;
        container-type: inline-size;
        container-name: tool-card;
    }

    .tool-card-empty {
        height: 96%;
        width: 96%;
        display: none;
        align-items: center;
        justify-content: center;
        filter: brightness(70%) opacity(60%);
        transform: translateY(3cqi);
        cursor: default;
        pointer-events: none;
    }

    .tool-card-content {
        height: 96%;
        position: relative;
        background-color: var(--card-bg);
        box-sizing: border-box;
        border-radius: 5.1cqi;
        border-bottom-right-radius: 8.3cqi;
        width: 96%;
        padding: 7.6cqi;
        overflow: hidden;
        cursor: pointer;
        user-select: none;
    }

    .tool-card-content::after {
        content: "";
        position: absolute;
        inset: 0;
        pointer-events: none;
        mix-blend-mode: multiply;
        background: linear-gradient(to bottom, transparent 0%, transparent 90%, #8577773b 100%);
    }

    /* ── Corners ── */
    .card-notch {
        position: absolute;
        background-color: var(--card-bg);
        width: var(--notch-w);
        height: var(--notch-h);
        top: 7cqi;
        z-index: 2;
        display: flex;
        flex-direction: column;
        align-items: left;
        border-bottom-right-radius: 6cqi;
    }

    .card-notch h1 {
        color: color-mix(in srgb, var(--card-black) 85%, transparent);
        font-family: 'Barqen', sans-serif;
        line-height: 1;
    }

    .card-notch[data-red="true"] .rank {
        color: color-mix(in srgb, var(--card-pink) 85%, transparent);
    }

    .card-notch[data-red="true"] :global(.suit) {
        color: color-mix(in srgb, var(--card-pink) 88%, transparent);
    }

    .card-notch .rank {
        font-size: var(--rank-size);
        margin: 0.6cqi 0;
    }

    .card-notch :global(.suit) {
        margin: var(--notch-suit-margin);
        color: color-mix(in srgb, var(--card-black) 88%, transparent);
    }

    /* ── Content ── */
    .tool-card-information {
        height: 98%;
        overflow: hidden;
        border: 1.16cqi solid color-mix(in srgb, var(--card-pink) 85%, transparent);
        border-radius: 2.1cqi;
        border-bottom-right-radius: 8.3cqi;
    }

    .tool-card-thumbnail {
        height: var(--thumb-height);
        overflow: hidden;
        position: relative;
    }

    .tool-card-thumbnail img,
    .tool-card-thumbnail-empty {
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: block;
        filter: grayscale(20%);
        border-radius: 0;
    }

    .tool-card-thumbnail::after {
        content: "";
        position: absolute;
        inset: 0;
        mix-blend-mode: multiply;
        background: linear-gradient(to bottom, #575555af 0%, transparent 25%, transparent 100%);
        pointer-events: none;
    }

    .tool-card-body {
        padding: 0.65rem 0.75rem 0.4rem;
        flex: 1;
        min-width: 0;
    }

    .tool-card-title {
        position: absolute;
        top: 14cqi;
        right: 13cqi;
        width: 56cqi;
        color: var(--card-title);
        text-align: right;
        text-transform: uppercase;
        font-family: 'Citylight';
        font-size: var(--title-size);
        font-weight: 100;
    }

    .tool-card-body p {
        margin: 0;
        font-size: 5.3cqi;
        line-height: 1.3;
        color: var(--page-secondaryfont);
        display: -webkit-box;
        -webkit-line-clamp: 3;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }

    .tool-card-stack {
        position: absolute;
        bottom: 14cqi;
        left: 12cqi;
        display: flex;
        flex-direction: row;
        align-items: center;
        gap: 1.6cqi;
    }

    /* ── Variant sizing (this replaces the second component's overrides) ── */
    .tool-card[data-variant="full"] {
        aspect-ratio: 500 / 750;
        --notch-w: 14.3cqi;
        --notch-h: 32cqi;
        --notch-icon-size: 14.3cqi;
        --notch-suit-margin: -5cqi -1.6cqi;
        --rank-size: 20cqi;
        --title-size: 14cqi;
        --thumb-height: 68%;
    }

    .tool-card[data-variant="mini"] {
        aspect-ratio: 500 / 650;
        opacity: 0;
        --notch-w: 12cqi;
        --notch-h: 27cqi;
        --notch-icon-size: 11.1cqi;
        --notch-suit-margin: -4cqi -1.6cqi;
        --rank-size: 16cqi;
        --title-size: 13cqi;
        --thumb-height: 60%;
    }

    .tool-card[data-variant="full"] .tool-card-content,
    .tool-card[data-variant="full"] .tool-card-empty {
        transform: translateY(3cqi);
    }

    @media (hover: hover) and (pointer: fine) {
        .tool-card[data-variant="full"][data-state="active"] .tool-card-content:hover {
            transform: translateY(2cqi);
        }
        .tool-card[data-variant="mini"] .tool-card-content:hover {
            transform: translateY(-2cqi);
        }
    }

    /* ── State machine (full deck: empty/hidden/active) ── */
    .tool-card[data-state="hidden"] { visibility: hidden; pointer-events: none; }
    .tool-card[data-state="empty"] .tool-card-content { display: none; }
    .tool-card[data-state="empty"] .tool-card-empty   { display: flex; }
    .tool-card[data-state="active"] .tool-card-content { display: flex; }
    .tool-card[data-state="active"] .tool-card-empty   { display: none; }

    .tool-card[data-variant="full"][data-state="active"] {
        animation: flipIn 1.5s cubic-bezier(0.22, 1, 0.36, 1) forwards;
    }

    /* ── State machine (mini grid: pending/active/leaving/gone) ── */
    .tool-card[data-variant="mini"][data-state="active"] {
        animation: flipIn 0.5s ease forwards;
    }
    .tool-card[data-variant="mini"][data-state="gone"] {
        display: none;
    }
    .tool-card[data-variant="mini"][data-state="leaving"] {
        animation: cardOut 0.22s ease forwards;
        pointer-events: none;
    }

    @keyframes flipIn {
        from { transform: translateX(20px) rotateY(-90deg) scale(0.9); opacity: 0; }
        to   { transform: translateX(0) rotateY(0deg) scale(1); opacity: 1; }
    }

    @keyframes cardOut {
        from { opacity: 1; transform: scale(1); }
        to   { opacity: 0; transform: scale(0.95); }
    }

    /* ── Mobile ── */
    @media (orientation: portrait), (max-aspect-ratio: 9/16) {
        .tool-card[data-variant="full"] .tool-card-content,
        .tool-card[data-variant="full"] .tool-card-empty {
            transform: translateY(10px);
        }

        .tool-card[data-variant="mini"] .tool-card-body {
            padding: 0.50rem 0.50rem 0.4rem;
        }
        .tool-card[data-variant="mini"] .tool-card-thumbnail {
            height: 50%;
        }
        .tool-card[data-variant="mini"] .tool-card-body p {
            font-size: 6cqi;
            -webkit-line-clamp: 4;
        }
    }
</style>

<script>
    document.querySelectorAll<HTMLElement>('[data-href]').forEach(card => {
        card.addEventListener('click', () => {
            const href = card.dataset.href;
            if (href) window.location.href = href;
        });
    });
</script>