---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import StackBadge from '../props/StackBadge.astro';
import Icon from '../widgets/Icon.astro';
import type { CreditEntry } from '../../objects/CreditEntry';

interface Props {
    entry?: CreditEntry ;
    index?: number;
    variant?: 'full' | 'mini';
}

const { entry, index = 0, variant = 'full' } = Astro.props;

const numId       = entry?.id           ?? null;
const title       = entry?.title        ?? "";
const studio       = entry?.studio        ?? "";
const type        = entry?.type     ?? "";
const year        = entry?.year     ?? "";
const duration    = entry?.duration ?? "";
const poster      = entry?.posterPath   ?? null;
const role        = entry?.role     ?? "";
const link        = entry?.link;

---

<div class="credit-card"
    data-variant={variant}
    data-title={title}
    data-flipped="false"
>
    <div class="credit-card-content">
         <div class="credit-card-header">
            <i class="credit-card-slot" aria-hidden="true"></i>
            <span>{studio}</span>
        </div>
        {poster && 
            <div class="credit-card-poster" >
                <img src={poster} alt={title} loading="lazy" />
            </div>
        
        }
        <span class="credit-card-foot">
            <span>{role}</span>
            <span>{year}</span>
        </span>

    </div>

</div>

<style>

    .credit-card {
        --card-bg: var(--credit-card-bg);
        --card-pink: var(--credit-card-pink);
        --card-black: var(--credit-card-black);
        --card-white: var(--credit-card-white);
        --card-title: var(--credit-card-title);

        width: 100%;
        height: 100%;
        overflow: visible;
        transform-style: preserve-3d;
        box-sizing: border-box;
        container-type: inline-size;
        container-name: credit-card;        
    }

    .credit-card-content {
        display: flex;
        flex-direction: column;
        aspect-ratio: 2 / 3.8;
        border-radius: 3cqi;
        background: #17140f;
        color: #f4a6d7;
        border: 1px solid rgb(255 255 255 / 0.14);
        overflow: hidden;
        box-shadow: 0 10px 18px rgb(0 0 0 / 0.35);

    }
    
    .credit-card-header {
        display: flex;
        flex-direction: column;
        align-items: center;
        padding-top: 4cqi;
        padding-bottom: 3cqi;

        background: #f4a6d7;
        color: #1a1a1a;
    }
    
    /* the lanyard slot */
    .credit-card-slot {
        width: 15cqi;
        height: 5cqi;
        margin-bottom: 1cqi;
        border-radius: 999px;
        background: #17140f;
    }
    
    .credit-card-poster {
        position: relative;
    }

    .credit-card-poster img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        object-position: center;
    }
    
    .credit-card-foot {
        flex: none;
        display: flex;
        justify-content: space-between;
        padding: 0.55rem 0.8rem 0.7rem;
        border-top: 1px solid rgb(255 255 255 / 0.12);
    }
    
</style>

