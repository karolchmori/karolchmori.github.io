---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import StackBadge from '../props/StackBadge.astro';
import Icon from '../widgets/Icon.astro';
import type { CreditEntry } from '../../objects/CreditEntry';

interface Props {
    entry?: CreditEntry ;
    index?: number;
    variant?: 'full' | 'mini';
    sleevePadding?: string;
}

const { entry, index = 0, variant = 'full', sleevePadding='3cqi' } = Astro.props;

const numId       = entry?.id           ?? null;
const title       = entry?.title        ?? "";
const studio       = entry?.studio        ?? "";
const type        = entry?.type     ?? "";
const year        = entry?.year     ?? "";
const poster      = entry?.posterPath   ?? null;
const role        = entry?.role     ?? "";
const link        = entry?.link;
const typeColor = entry?.color ?? '#f4a6d7';
const posterMargin = entry?.posterMargin ?? '10cqi';

---

<div class="credit-card"
    data-variant={variant}
    data-title={title}
    data-flipped="false"
    style={`--poster-margin: ${posterMargin}; --sleeve-padding: ${sleevePadding}; --type-color: ${typeColor}`}
>
    <span class="credit-card-clip" aria-hidden="true"></span>

    <div class="credit-card-sleeve">
        <div class="credit-card-content">
            {poster && 
                <div class="credit-card-poster" >
                    <img src={poster} alt={title} loading="lazy" />
                </div>
            
            }

            <div class="credit-card-header">
                <i class="credit-card-slot" aria-hidden="true"></i>
                <div class="credit-card-meta">
                    <span>{studio}</span>
                    <span>{role}</span>
                </div>
            </div>

        </div>
    </div>
    

</div>

<style>

    .credit-card {
        --card-bg: var(--credit-card-bg);
        --card-pink: var(--credit-card-pink);
        --card-black: var(--credit-card-black);
        --card-white: var(--credit-card-white);
        --card-title: var(--credit-card-title);
        --clip-color: #55525a;

        position: relative;  
        width: 100%;
        height: 100%;
        overflow: visible;
        transform-style: preserve-3d;
        box-sizing: border-box;
        container-type: inline-size;
        container-name: credit-card;        
    }

    .credit-card span {
        font-size: 6cqi;
        margin-top: 2cqi;
        line-height: 1;
        font-family: 'Barqen', sans-serif;
        letter-spacing: 1px;
    }

    .credit-card-sleeve {
        position: relative;
        padding: var(--sleeve-padding);
        border-radius: 7cqi;
        background: rgb(235 235 240 / 0.10);
        border: 1.5px solid rgb(235 235 240 / 0.25);
        box-shadow: 0 10px 18px rgb(0 0 0 / 0.35);
        box-sizing: border-box;

    }

    /* glare streaks across the plastic */
    .credit-card-sleeve::before,
    .credit-card-sleeve::after {
        content: "";
        position: absolute;
        inset: 0;
        z-index: 3;
        pointer-events: none;
        border-radius: inherit;
    }
 
    .credit-card-sleeve::before {
        background: rgb(255 255 255 / 0.07);
        clip-path: polygon(27% 0, 55% 0, 1% 92%, 1% 72%);
    }
 
    .credit-card-sleeve::after {
        background: rgb(255 255 255 / 0.02);
        clip-path: polygon(64% 0, 73% 0, 0 100%, 0 94%);
    }

    .credit-card-content {
        position: relative;  
        aspect-ratio: 2 / 3;
        border-radius: 3cqi;
        background: #17140f;
        border: 1px solid rgb(255 255 255 / 0.14);
        overflow: hidden;
        box-shadow: 0 10px 18px rgb(0 0 0 / 0.35);

    }

    /* ---------- the clip ----------
   ::before = top rectangle where the straps enter
   ::after  = short neck + body that widens toward the bottom      */
    .credit-card-clip {
        /* all shades are derived from --clip-color */
        --clip-light: color-mix(in srgb, var(--clip-color), white 35%);
        --clip-dark:  color-mix(in srgb, var(--clip-color), black 30%);
        --clip-edge:  color-mix(in srgb, var(--clip-color), black 45%);
        --clip-slit:  color-mix(in srgb, var(--clip-color), black 60%);
        --clip-shade: linear-gradient(
            to right,
            var(--clip-dark) 0%,
            var(--clip-light) 22%,
            var(--clip-color) 65%,
            var(--clip-dark) 100%
        );

        position: absolute;
        z-index: 4;
        top: -17cqi;
        left: 50%;
        width: 12cqi;
        height: 28.5cqi;
        transform: translateX(-50%);
        pointer-events: none;

        /* thin outline that follows the shape, then the soft drop shadow */
        filter:
            drop-shadow(0 0 0.2cqi var(--clip-edge))
            drop-shadow(0 0.6cqi 0.9cqi rgb(0 0 0 / 0.35));
    }

    /* top rectangle */
    .credit-card-clip::before {
        content: "";
        position: absolute;
        top: 0;
        left: 50%;
        width: 12cqi;
        height: 9.5cqi;
        transform: translateX(-50%);
        border-radius: 0.8cqi;
        background:
            linear-gradient(var(--clip-slit) 0 0) 50% 0 / 70% 0.9cqi no-repeat,
            var(--clip-shade);
    }

    /* neck + body */
    .credit-card-clip::after {
        content: "";
        position: absolute;
        top: 9cqi;
        left: 0;
        width: 100%;
        height: 16cqi;
        background: var(--clip-shade);
        clip-path: polygon(
            32% 0, 68% 0,
            79% 19%,
            99% 92%,
            95% 100%,
            5% 100%,
            1% 92%,
            21% 19%
        );
    }
 

    
    .credit-card-header {
        position: relative;
        z-index: 1;
        flex: none;
        display: flex;
        flex-direction: column;
        align-items: center;
        padding-top: 4cqi;
        padding-bottom: 2cqi;
        padding-inline: 3cqi;
        box-shadow: 0 5px 5px #00000046;
        background: var(--type-color);
        color: #fbf6f8;
    }

    .credit-card-meta {
        display: flex;
        justify-content: space-between;
        width: 100%;
        font-size: 4cqi;
    }

    .credit-card-slot {
        width: 20cqi;
        height: 5cqi;
        margin-bottom: 1cqi;
        border-radius: 999px;
        background: #17140f;
    }

    
    .credit-card-poster {
        position: absolute;
        padding-top: var(--poster-margin);
        z-index: 0;
    }

    .credit-card-poster::after {
        content: "";
        position: absolute;
        inset: 0;
        pointer-events: none;
        background:
            linear-gradient(#ffffff07, #ffffff07),
            linear-gradient(to bottom, transparent 0%, transparent 87%, #161212da 95%, #161212f1 100%);
            
    }

    .credit-card-poster img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        object-position: center;
        display: block;
        
    }


    
    
</style>

