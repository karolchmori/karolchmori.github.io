---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import StackBadge from '../props/StackBadge.astro';
import Icon from '../widgets/Icon.astro';
import type { CreditEntry } from '../../objects/CreditEntry';

interface Props {
    entry?: CreditEntry ;
    index?: number;
    variant?: 'full' | 'mini';
    posterMargin?: string;
}

const { entry, index = 0, variant = 'full', posterMargin='10cqi' } = Astro.props;

const numId       = entry?.id           ?? null;
const title       = entry?.title        ?? "";
const studio       = entry?.studio        ?? "";
const type        = entry?.type     ?? "";
const year        = entry?.year     ?? "";
const duration    = entry?.duration ?? "";
const poster      = entry?.posterPath   ?? null;
const role        = entry?.role     ?? "";
const link        = entry?.link;
const typeColor = entry?.color ?? '#f4a6d7';

---

<div class="credit-card"
    data-variant={variant}
    data-title={title}
    data-flipped="false"
    style={`--poster-margin: ${posterMargin}; --type-color: ${typeColor}`}
>
    <div class="credit-card-content">
        {poster && 
            <div class="credit-card-poster" >
                <img src={poster} alt={title} loading="lazy" />
            </div>
        
        }

         <div class="credit-card-header">
            <i class="credit-card-slot" aria-hidden="true"></i>
            <div class="credit-card-meta">
                <span>{studio}</span>
                <span>{role}</span>
            </div>
        </div>

    </div>

</div>

<style>

    .credit-card {
        --card-bg: var(--credit-card-bg);
        --card-pink: var(--credit-card-pink);
        --card-black: var(--credit-card-black);
        --card-white: var(--credit-card-white);
        --card-title: var(--credit-card-title);

        width: 100%;
        height: 100%;
        overflow: visible;
        transform-style: preserve-3d;
        box-sizing: border-box;
        container-type: inline-size;
        container-name: credit-card;        
    }

    .credit-card-content {
        position: relative;  
        aspect-ratio: 2 / 3;
        border-radius: 3cqi;
        background: #17140f;
        border: 1px solid rgb(255 255 255 / 0.14);
        overflow: hidden;
        box-shadow: 0 10px 18px rgb(0 0 0 / 0.35);

    }

    
    .credit-card-header {
        position: relative;
        z-index: 1;
        flex: none;
        display: flex;
        flex-direction: column;
        align-items: center;
        padding-top: 4cqi;
        padding-bottom: 2cqi;
        padding-inline: 3cqi;
        box-shadow: 0 5px 5px #00000046;
        background: var(--type-color);
        color: #fbf6f8;
    }

    .credit-card-meta {
        display: flex;
        justify-content: space-between;
        width: 100%;
        font-size: 4cqi;
    }

    .credit-card-slot {
        width: 20cqi;
        height: 5cqi;
        margin-bottom: 1cqi;
        border-radius: 999px;
        background: #17140f;
    }

    
    .credit-card-poster {
        position: absolute;
        inset: var(--poster-margin) 0 0 0; 
        z-index: 0;
    }

    .credit-card-poster::after {
        content: "";
        position: absolute;
        inset: 0;
        pointer-events: none;
        background:
            linear-gradient(#ffffff07, #ffffff07),
            linear-gradient(to bottom, transparent 0%, transparent 87%, #161212da 95%, #161212f1 100%);
            
    }

    .credit-card-poster img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        object-position: center;
        display: block;
        
    }


    
    
</style>

