---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import StackBadge from '../props/StackBadge.astro';
import Icon from '../widgets/Icon.astro';
import type { CreditEntry } from '../../objects/CreditEntry';

interface Props {
    entry?: CreditEntry ;
    index?: number;
    variant?: 'full' | 'mini';
}

const { entry, index = 0, variant = 'full' } = Astro.props;

const numId       = entry?.id           ?? null;
const title       = entry?.title        ?? "";
const type        = entry?.type     ?? "";
const year        = entry?.year     ?? "";
const duration    = entry?.duration ?? "";
const poster      = entry?.posterPath   ?? null;
const role        = entry?.role     ?? "";
const link        = entry?.link;

---

<div class="credit-card"
    data-variant={variant}
    data-title={title}
    data-flipped="false"
>
    <div class="credit-card-content credit-card-front">
        {poster && <img src={poster} alt={title} loading="lazy" />}

    </div>
    <div class="credit-card-content credit-card-back">
        <div class="back-header">
            <span class="back-index">No. {numId}</span>
        </div>
        <div class="back-table">
            <div class="back-row back-row--title">
                <span class="back-label back-label--title">Title</span>
                <span class="back-value back-value--title">{title}</span>
                <span class="back-value back-value--year">{year}</span>
            </div>
            <div class="back-row">
                <div class="back-cell">
                    <span class="back-label">Type</span>
                    <span class="back-value">{type}</span>
                </div>
                <div class="back-cell">
                    <span class="back-label">Duration</span>
                    <span class="back-value">{duration}</span>
                </div>
            </div>
            <div class="back-row">
                <div class="back-cell">
                    <span class="back-label">Role</span>
                    <span class="back-value">{role}</span>
                </div>
            </div>
            <div class="back-row">
                <a class="back-value back-value--watch" href={link}>Watch</a>
            </div>
        </div>
        

    </div>

</div>

<style>

    :root {
        --card-bg: var(--credit-card-bg);
        --card-pink: var(--credit-card-pink);
        --card-black: var(--credit-card-black);
        --card-white: var(--credit-card-white);
        --card-title: var(--credit-card-title);

        --rCorner: 40px; 
        --rInner: 25px; 
        --opacity: 0.8;
    }


    .credit-card {
        position: relative;
        width: 100%;
        aspect-ratio: 2 / 3;
        overflow: visible;
        transform-style: preserve-3d;
        box-sizing: border-box;
        container-type: inline-size;
        container-name: credit-card;


        mask: 
            radial-gradient(circle var(--rCorner) at 0 0, transparent var(--rCorner), black calc(var(--rCorner) + 1px)),
            radial-gradient(circle var(--rCorner) at 100% 0, transparent var(--rCorner), black calc(var(--rCorner) + 1px)),
            radial-gradient(circle var(--rInner) at 0 70%, transparent var(--rInner), black calc(var(--rInner) + 1px)),
            radial-gradient(circle var(--rCorner) at 0 100%, transparent var(--rCorner), black calc(var(--rCorner) + 1px)),
            radial-gradient(circle var(--rInner) at 100% 70%, transparent var(--rInner), black calc(var(--rInner) + 1px)),
            radial-gradient(circle var(--rCorner) at 100% 100%, transparent var(--rCorner), black calc(var(--rCorner) + 1px));
        
        mask-composite: intersect;
    }

    .credit-card-content {
        position: absolute; 
        inset: 2%; 
        overflow: hidden;
        cursor: pointer;
        user-select: none;
        transition: opacity 0.3s ease;
        pointer-events: none;
    }

    .credit-card-front img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        border-radius: inherit;
    }

    .credit-card-front {
        background-color: #cec4c4;
        opacity: 1;
    }

    .credit-card-back {
        background-color: var(--card-bg);
        color: var(--card-black);
        opacity: 0;
        padding-top: 9cqi !important;
        padding: 11cqi;
    }

    .back-header {
        display: flex;
        justify-content: flex-end;
        font-size: 5cqi;
        line-height: 1;
        margin-bottom: 1cqi;
        opacity: var(--opacity);
    }


    .back-table {
        height: 115cqi;
        flex: 1;
        display: grid;
        grid-template-rows: 3fr 2fr 1fr 1fr; 
        border: 1px solid var(--card-pink);
        
    }

    .back-row {
        display: flex;
        flex-direction: column;
        justify-content: center;
        padding: 0cqi 3cqi;
        border-top: 1px solid var(--card-pink);
    }

    .back-cell {
        display: flex;
        flex-direction: row;
        justify-content: space-between;
        align-items: baseline;
    }


    .back-label {
        font-size: 4.6cqi;
        text-transform: uppercase;
        letter-spacing: 0.4cqi;
        opacity: var(--opacity);
        margin-bottom: 1cqi;
    }

    .back-label--title {
        position: absolute;
        top: 17cqi;
        
    }

    .back-value {
        font-size: 6cqi;
    }

    .back-value--title {
        width: 65cqi;
        font-size: 11cqi;
        line-height: 1.15;
        font-weight: 700;
        margin-inline: auto;
        text-transform: uppercase;
        text-align: center;
        
    }

    .back-value--year {
        position: absolute;
        line-height: 1.15;
        top: 18cqi;
        right: 14cqi;
    }

    .back-value--watch {
        width: 65cqi;
        font-size: 8cqi;
        line-height: 1.15;
        font-weight: 400;
        margin-inline: auto;
        text-transform: uppercase;
        text-align: center;
        text-decoration: underline;
        opacity: var(--opacity);
    }

    

    @media (hover: hover) and (pointer: fine){
        .credit-card:hover .credit-card-back {
            opacity: 1;
            pointer-events: auto;
        }

        .credit-card:hover .credit-card-front {
            opacity: 0;
        }
    }
    

    
    @media (orientation: portrait), (max-aspect-ratio: 9/16) {
        .credit-card {
            --rCorner: 35px; 
            --rInner: 20px; 
        }


        .credit-card[data-flipped="true"] .credit-card-back {
            opacity: 1;
            pointer-events: auto;
        }

        .credit-card[data-flipped="true"] .credit-card-front {
            opacity: 0;
        }
    }

</style>

<script>
    const mq = window.matchMedia('(orientation: portrait), (max-aspect-ratio: 9/16)');

    function bindFlip() {
        document.querySelectorAll<HTMLElement>('.credit-card').forEach(card => {
            card.addEventListener('click', handleClick);
        });
    }

    function unbindFlip() {
        document.querySelectorAll<HTMLElement>('.credit-card').forEach(card => {
            card.removeEventListener('click', handleClick);
            card.dataset.flipped = 'false';
        });
    }

    function handleClick(e: Event) {
        const card = e.currentTarget as HTMLElement;
        const flipped = card.dataset.flipped === 'true';
        card.dataset.flipped = String(!flipped);
    }

    function syncToMedia(e: MediaQueryList | MediaQueryListEvent) {
        if (e.matches) {
            bindFlip();
        } else {
            unbindFlip();
        }
    }

    syncToMedia(mq);
    mq.addEventListener('change', syncToMedia); 

</script>