---
interface Props {
  opacity?: number;
}

const { opacity = 0.97 } = Astro.props;
---

<div class="vignette" style={`--vignette-opacity: ${opacity};`} />

<style>
  .vignette {
    content: "";
    position: fixed;
    inset: 0;
    pointer-events: none;

    background: radial-gradient(
      ellipse 300% 70% at 50% 60%,
      transparent 0%,
      transparent 75%,
      rgba(12, 9, 12, 0.836) 80%,
      rgba(0, 0, 0, 0.952) 100%
    );

    opacity: var(--vignette-opacity);
    z-index: 99;
  }
</style>