---
interface Props {
  opacity?: number;
}

const { opacity = 1 } = Astro.props;
---

<div class="vignette" style={`--vignette-opacity: ${opacity};`} />

<style>
  .vignette {
    content: "";
    position: fixed;
    inset: 0;
    pointer-events: none;

    background: radial-gradient(
      ellipse 300% 70% at 50% 60%,
      transparent 0%,
      transparent 76%,
      rgba(15, 10, 15, 0.945) 80%,
      rgba(8, 5, 8, 0.986) 100%
    );

    opacity: var(--vignette-opacity);
    z-index: 99;
  }
</style>