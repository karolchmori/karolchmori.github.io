---
import Picture from './Picture.astro';
import SkillsGroup from '../props/SkillsGroup.astro';

interface Props {
	thumbnail?: ImageMetadata | null; // pass the first carousel frame here, not a separate thumbnail
	title: string;
	description?: string;
	software?: string;
	stack?: string[];
}

const { thumbnail, title, description, software, stack = [] } = Astro.props;
---

<div class="hero-banner">
	{thumbnail && (
		<div class="hero-banner-thumb">
			<Picture src={thumbnail} alt="" draggable={false} />
		</div>
	)}
	<div class="hero-banner-content">
		<h2 class="hero-banner-title">{title}</h2>
		{description && <p class="hero-banner-description">{description}</p>}
		{(software || stack.length > 0) && (
			<SkillsGroup  title='' items={[software, ...stack].filter((item): item is string => Boolean(item))}  accent={software ? 1 : 0} />
		)}
	</div>
</div>

<style>
	.hero-banner {
		display: flex;
		align-items: center;
		gap: 1.25rem;
		width: 100%;
		padding: 1.25rem 1.25rem;
		background: var(--page-secondarybg);
		border-bottom: 1px solid color-mix(in srgb, var(--comp-secondarybg) 95%, var(--page-fourfont));
		border-start-start-radius: 14px;
		overflow: visible;
		
	}

	.hero-banner-thumb {
		flex-shrink: 0;
		width: 14%;
		aspect-ratio: 1 / 1;
		border-radius: 8px;
		overflow: hidden;
		background: var(--page-secondarybg);
		
	}

	.hero-banner-thumb :global(img) {
		width: 100%;
		height: 100%;
		object-fit: cover;
		display: block;
	}

	.hero-banner-content {
		flex: 1;
		min-width: 0;
		flex-wrap: wrap;
	}

	.hero-banner-title {
		margin: 0;
		font-weight: 600;
		color: var(--black);
		font-stretch: semi-condensed;
	}

	.hero-banner-description {
		margin-right: 2.5rem;
		margin-top: 0.25rem;
		font-size: 1rem;
		color: var(--gray-medium);
	}


	@media (orientation: portrait), (max-aspect-ratio: 9/16) {
        .hero-banner-thumb {
			display: none;
		}
    }

</style>