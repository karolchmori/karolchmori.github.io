---
import Logo from './Logo.astro';
import HeaderLink from './HeaderLink.astro';

import ThemeToggle from './props/ThemeToggle.astro';
import SocialLinks from '../components/props/SocialLinks.astro';
import DropdownLink from './DropdownLink.astro'; 


interface Props {
    showThemeToggle?: boolean;
}

const { showThemeToggle = true } = Astro.props;

---
<header>
	<nav>
		<div class="header-logo">
			<Logo/>
		</div>
		
		<a class="hamburger" aria-label="Menu">☰</a>
		<div class="navigator-pages">
			{showThemeToggle && <ThemeToggle />}
			<HeaderLink href="/about-me">About Me</HeaderLink>
			<DropdownLink label="Work" href="/work" children={[
							{ label: 'Credits', href: '/work/credits' },
							{ label: 'Tools',   href: '/work/tools'   },
						]} />
			<HeaderLink href="/blog">Blog</HeaderLink>
			<HeaderLink href="/contact">Contact</HeaderLink>
			<div class="menu-social">
				<SocialLinks orientation="horizontal" size={30} gap={0.5}/>
			</div>
			
		</div>
	</nav>
</header>


<style>
	header {
		position: fixed;
		width: 100vw;
		height: 7.7vh;
		z-index: 1000;
	}


	nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
		padding-right: 3rem;
		padding-top: 0.1em;
		user-select: none;
	}

	.navigator-pages {
        display: flex;
        align-items: center;
        gap: 3rem;  
    }

    .hamburger  { display: none;  user-select: none;}
    .menu-social { display: none; }

    /* -------------------------------------------------------------- */ 
    /* ------------------- PHONE MODIFICATIONS ---------------------- */ 
    /* -------------------------------------------------------------- */ 

    @media (orientation: portrait), (max-aspect-ratio: 9/16) {
		header {
            background-color: #0C0A0D; 
        } 

        .header-logo {
            padding-top: 0.35em;
        }


        .hamburger { 
			position: absolute;
            display: block;
            background: none;
            color: var(--menu-title);
            border: none;
            font-size: 25px;
            cursor: pointer;
            z-index: 1001;
			top: 12%;
			right: 4%;	
        }


        .navigator-pages {
            position: absolute;
            top: 7.7vh;
            right: 0rem;
            width: auto;
            min-width: 180px;
            max-width: 250px;
            
            /* Not full height anymore! Auto height based on content */
            height: auto; 
            max-height: 80vh;
            overflow-y: auto;
            
            background: #0C0A0D;
            flex-direction: column;
            justify-content: flex-start;
            align-items: flex-end; 
            
            padding: 1.5rem 1.5rem;
            box-sizing: border-box;
            gap: 1.2rem; 
            
            /* --- CARD POP ANIMATION FIXES --- */
            transform-origin: top right;
            opacity: 0;
            visibility: hidden;
            transform: translateY(10px);
            transition: opacity 0.25s ease, transform 0.25s cubic-bezier(0.175, 0.885, 0.32, 1.275), visibility 0.25s ease; /* Bouncy spring effect */
            
            border-radius: 0 0 0 12px;
            box-shadow: -5px 10px 25px rgba(0, 0, 0, 0.4);
            border-left: 1px solid rgba(255, 255, 255, 0.05);
            border-bottom: 1px solid rgba(255, 255, 255, 0.05);
        }


        /* When open, it pops down smoothly */
        .navigator-pages.is-open { 
            opacity: 1;
            visibility: visible;
            transform: translateY(0);
        }

        .menu-social { display: flex; }
        
    }

</style>


<script>


  	window.addEventListener('scroll', () => {
		const header = document.querySelector('header');
		if (header){
			if (window.scrollY > 50) {
				header.classList.add('scrolled');
			} else {
				header.classList.remove('scrolled');
			}
		}
  	});


	const hamburger = document.querySelector('.hamburger');
    const navPages = document.querySelector('.navigator-pages');

	if (hamburger && navPages) {
        hamburger.addEventListener('click', (event) => {
            event.stopPropagation(); 
            navPages.classList.toggle('is-open');
        });

        const links = navPages.querySelectorAll('a');
        links.forEach(link => {
            link.addEventListener('click', () => {
                navPages.classList.remove('is-open');
            });
        });

        document.addEventListener('click', (event) => {
            const isMenuOpen = navPages.classList.contains('is-open');
            const target = event.target as Node; 
            const clickedOutside = !navPages.contains(target) && !hamburger.contains(target);

            if (isMenuOpen && clickedOutside) {
                navPages.classList.remove('is-open');
            }
        });
    }


</script>