---
import { SITE_TITLE } from '../consts';

interface Props {
    status?: 'animated'|'static';
}

const { status = 'static' } = Astro.props;

---
<a href="/" class={`site-logo ${status}`}>
    {SITE_TITLE}
</a>

<style>
    .site-logo {
		text-decoration: none;
        color: var(--menu-logo);
        font-family: var(--font-sandor), serif;
        font-weight: 400;

        font-size: var(--logo-size-default);
        transition: font-size 0.3s ease;
        margin-left: 0.5em;
        margin-top: 0.1em;
        user-select: none;
	}

    :global(header.scrolled) .site-logo {
        font-size: var(--logo-size-scrolled);
    }

    /* Hover */
    :global(header.scrolled) .site-logo:hover {
        color: var(--menu-accent);
    }

    .site-logo:hover {
		color: var(--menu-accent);
		font-weight: 300;
	}

    /* Font Size */
    .site-logo.animated {
        --logo-size-default: 31pt;
        --logo-size-scrolled: 26pt;
    }

    .site-logo.static {
        --logo-size-default: 26pt;
        --logo-size-scrolled: 26pt;
    }


    @media (orientation: portrait), (max-aspect-ratio: 9/16) {
		.site-logo.animated {
            --logo-size-default: 31pt;
            --logo-size-scrolled: 21pt;
        }

        .site-logo.static {
            --logo-size-default: 21pt;
            --logo-size-scrolled: 21pt;
        }
		
	}


</style>