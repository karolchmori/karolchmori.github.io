---
// ToolCard.astro
import CardA from '../../assets/icons/AS_CardA.svg';
import CardB from '../../assets/icons/AS_CardB.svg';
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import StackBadge from './StackBadge.astro';
import Icon from '../widgets/Icon.astro';


interface Props {
    entry?: CollectionEntry<'tool'>;
    index: number;
}

const { entry, index = 0 } = Astro.props;

const title       = entry?.data.title       ?? "";
const description = entry?.data.description ?? "";
const thumbnail   = entry?.data.thumbnail   ?? null;
const software    = entry?.data.software    ?? "";
const filePath    = entry?.id               ?? null;
const stack       = entry?.data.stack       ?? [];
const slug        = entry?.data.title.toLowerCase().replace(/\s+/g, '-') ?? null;


const initialState = entry ? "hidden" : "empty";
const suits = ['club', 'heart', 'diamond', 'spade'] as const;
const ranks = ["2", "3", "4", "5", "6", "7", "8", "9", "J", "Q", "K", "A"];


const cardIcon = index % 2 !== 0 ? CardA : CardB;
const cardRank = ranks[Math.floor(Math.random() * ranks.length)];
const cardSuit = suits[Math.floor(Math.random() * suits.length)];
const isRed = cardSuit === 'heart' || cardSuit === 'diamond';


---


<div class="tool-card" data-path={filePath} data-software={software} data-state={initialState} data-href={slug ? `/work/tools/${slug}` : null}>
    <div class="tool-card-empty">
        <img src={cardIcon.src} alt="" />
    </div>
    <div class="tool-card-content">
        <div class="card-notch top-left" data-red={isRed}>
            <h1 class="rank">{cardRank}</h1>
            <Icon name={cardSuit} size="4.3cqh" class="suit"/>
        </div>

        <!-- Bottom Right Cutout -->
        <div class="card-notch bottom-right" data-red={isRed}>
            <h1 class="rank">{cardRank}</h1>
            <Icon name={cardSuit} size="4.3cqh" class="suit"/>
        </div>

        <div class="tool-card-information">
            <div class="tool-card-thumbnail">
                {thumbnail 
                    ? <Image src={thumbnail} alt={title}/>
                    : <div class="tool-card-thumbnail-empty" />
                }
            </div>
            <h4 class="tool-card-title">{title}</h4>
            <div class="tool-card-stack">
                {stack.map(tech => <StackBadge name={tech}, backgroundcolor='var(--tool-card-white)', color='var(--tool-card-black)' size="3.6cqh"/>)}
            </div>
        </div>

  </div>
</div>


<style>

    :root {
        --card-bg: var(--tool-card-bg); 
        --card-pink: var(--tool-card-pink);
        --card-black: var(--tool-card-black);
        --card-white: var(--tool-card-white);
    }

    
    .tool-card-empty,
    .tool-card-content {
        height: 100%;
    }


    .tool-card {
        width: 100%;
        height: auto; 
        aspect-ratio: 500 / 750;


        overflow: visible;
        cursor: pointer;
        transform-style: preserve-3d;
        border-radius: 16px;
        padding-top: 16px;
        box-sizing: border-box;
    }

    @media (hover: hover) and (pointer: fine) {
        .tool-card[data-state="active"] .tool-card-content:hover{
            transform: translateY(-3px);
        }
    }

    .tool-card-empty {
        display: none;
        align-items: center;
        justify-content: center;
        filter: brightness(70%) opacity(60%);
    }


    .tool-card-content {
        position: relative;
        background-color: var(--card-bg);
        box-sizing: border-box;
        border-radius: 1.53cqh;
        width: 96%;
        padding: 3cqh;
    }

    /* ── CORNERS ── */
    .card-notch {
        position: absolute;
        background-color: var(--card-bg); /* Matches the border perfectly */
        width: 4.3cqh;
        height: 9.6cqh;
        z-index: 2;
        display: flex;
        flex-direction: column;
        align-items: left;
        
        border-bottom-right-radius: 1.79cqh;

    }

    .card-notch h1{
        color: var(--card-black);
        font-family: 'Barqen', sans-serif;
        line-height: 1;
        
    }

    .card-notch[data-red="true"] .rank {
        color: var(--card-pink);
    }

    .card-notch[data-red="true"] :global(.suit){
        color: var(--card-pink);
    }

    
    .card-notch.bottom-right {
        bottom: 3.2cqh; 
        right: 2.8cqh;
        transform: rotate(180deg);
    }

    .card-notch .rank {
        font-size: 6cqh;
        margin: 0.2cqh 0;
    }

    .card-notch :global(.suit) {
        margin: -1.5cqh -0.5cqh;
        color: var(--card-black);
    }


    /*  Content  */
    .tool-card-information {
        height: 98%;
        border-radius: 2px;
        overflow: hidden;    
        border: 0.35cqh solid var(--card-pink);
        border-radius: 0.63cqh; 
    }


    .tool-card-thumbnail {
        height: 100%;
        overflow: hidden;
        position: relative;
    }

    .tool-card-thumbnail img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: block;
        border-radius: 0px;
        filter: grayscale(20%);
    }

    .tool-card-thumbnail::after {
        content: "";
        position: absolute;
        inset: 0; 
        mix-blend-mode: multiply;
        
        background: linear-gradient(
            to bottom, 
            #575555 0%, 
            transparent 15%, 
            transparent 75%, 
            #575555 100%
        );
        
        pointer-events: none; 
    }



    .tool-card-title {
        position: absolute; 
        top: 3.8cqh;
        right: 3.8cqh;
        width: 21cqh;
        
        text-align: right;
        font-family: 'Citylight';
        font-size: 4.4cqh;
        font-weight: 100;
        text-transform: uppercase;
        color: var(--card-white);
    }


    .tool-card-stack {
        position: absolute; 
        bottom: 3.8cqh;
        left: 3.8cqh;
        display: flex;
        flex-direction: row;
        align-items: center;
        gap: 0.5cqh;
    }

    /* Visibility status */
    .tool-card[data-state="hidden"] { visibility: hidden; pointer-events: none;}

    .tool-card[data-state="empty"] .tool-card-content { display: none; }
    .tool-card[data-state="empty"] .tool-card-empty   { display: flex; }

    .tool-card[data-state="active"] .tool-card-content { display: flex; }
    .tool-card[data-state="active"] .tool-card-empty   { display: none; }


    .tool-card[data-state="active"] {
        animation: flipIn 1.5s cubic-bezier(0.22, 1, 0.36, 1) forwards;
        
    }


    @keyframes dealCard {
        0% {
            opacity: 0;
        }
        20% {
            transform: translateY(-20px) rotate(var(--deal-angle, 0deg)) scale(0.8);
            opacity: 0;
        }
        100% {
            transform: translateY(0) rotate(0deg) scale(1);
            opacity: 1;
        }
    }


    @keyframes flipIn {
        from {
            transform: translateX(20px) rotateY(-90deg) scale(0.9);
            opacity: 0;
        }
        to {
            transform: translateX(0) rotateY(0deg) scale(1);
            opacity: 1;
        }
    }

    @keyframes fadeOut {
        from {
            opacity: 1;
            transform: rotateY(0deg) scale(1);
        }
        to {
            opacity: 0;
            transform: rotateY(-90deg) scale(0.9);
        }
    }

     /* ── MOBILE ── */
	@media (orientation: portrait), (max-aspect-ratio: 9/16) {
        .card-notch {
            width: 4.4cqh;
            height: 9.7cqh;
            border-bottom-right-radius: 2cqh;
            
        }

        .card-notch :global(.suit) {
            margin: -1.4cqh -0.5cqh;
        }

        .tool-card-title {
            top: 4.8cqh;
            right: 4.2cqh;
            font-size: 5.2cqh;
            width: 25cqh;
        }

        .tool-card-stack {
            bottom: 4.2cqh;
            left: 4.2cqh;
        }

    }


</style>


<script>
    document.querySelectorAll<HTMLElement>('.tool-card[data-href]').forEach(card => {
        card.addEventListener('click', () => {
            const href = card.dataset.href;
            if (href) window.location.href = href;
        });
    });
</script>