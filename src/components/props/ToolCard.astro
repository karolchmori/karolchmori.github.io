---
// ToolCard.astro
import CardA from '../../assets/icons/AS_CardA.svg';
import CardB from '../../assets/icons/AS_CardB.svg';
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import StackBadge from './StackBadge.astro';


interface Props {
    entry?: CollectionEntry<'tool'>;
    index: number;
}

const { entry, index = 0 } = Astro.props;

const title       = entry?.data.title       ?? "";
const description = entry?.data.description ?? "";
const thumbnail   = entry?.data.thumbnail   ?? null;
const software    = entry?.data.software    ?? "";
const filePath    = entry?.id               ?? null;
const stack       = entry?.data.stack       ?? [];
const slug        = entry?.data.title.toLowerCase().replace(/\s+/g, '-') ?? null;


const initialState = entry ? "hidden" : "empty";
const suits = ["♣\uFE0E", "♥\uFE0E", "♦\uFE0E", "♠\uFE0E"];
const ranks = ["2", "3", "4", "5", "6", "7", "8", "9", "J", "Q", "K", "A"];


const cardIcon = index % 2 !== 0 ? CardA : CardB;
const cardRank = ranks[index % ranks.length]; 
const cardSuit = suits[index % suits.length];


---


<div class="tool-card" data-path={filePath} data-software={software} data-state={initialState} data-href={slug ? `/work/tools/${slug}` : null}>
    <div class="tool-card-empty">
        <img src={cardIcon.src} alt="" />
    </div>
    <div class="tool-card-content">
        <div class="card-notch top-left">
            <h1 class="rank">{cardRank}</h1>
            <h1 class="suit">{cardSuit}</h1>
        </div>

        <!-- Bottom Right Cutout -->
        <div class="card-notch bottom-right">
            <h1 class="rank">{cardRank}</h1>
            <h1 class="suit">{cardSuit}</h1>
        </div>

        <div class="tool-card-information">
            <div class="tool-card-thumbnail">
                {thumbnail 
                    ? <Image src={thumbnail} alt={title}/>
                    : <div class="tool-card-thumbnail-empty" />
                }
            </div>
            <h4 class="tool-card-title">{title}</h4>
            <div class="tool-card-stack">
                    {stack.map(tech => <StackBadge name={tech}, backgroundcolor='#D5CFCE', color='#2b2b2b' size="4cqh"/>)}
            </div>
        </div>

  </div>
</div>


<style>

    :root {
        --card-border-color: #D5CFCE; 
        --card-pink-line: #AE385E;
    }

    .tool-card p {
        margin-top: 4%;
    }

    .tool-card p, h4{
        color: #161A20;
    }

    
    .tool-card-empty,
    .tool-card-content {
        height: 100%;
    }

    .tool-card img {
        max-width: 100%;
        max-height: 100%;
        width: auto;
        height: auto;
    }

    .tool-card {
        width: 100%;
        height: auto; 
        aspect-ratio: 500 / 750;


        overflow: visible;
        cursor: pointer;
        transform-style: preserve-3d;
        border-radius: 16px;
        padding-top: 16px;
        box-sizing: border-box;
    }

    @media (hover: hover) and (pointer: fine) {
        .tool-card[data-state="active"] .tool-card-content:hover{
            transform: translateY(-3px);
        }
    }

    .tool-card-empty {
        display: none;
        align-items: center;
        justify-content: center;
        filter: brightness(70%) opacity(60%);
    }


    .tool-card-content {
        position: relative;
        display: none;
        background-color: var(--card-border-color);
        box-sizing: border-box;
        border-radius: 1.53cqh;
        width: 96%;
        padding: 3cqh;
    }

    /* ── The Notches / Inverse Corners ── */
    .card-notch {
        position: absolute;
        background-color: var(--card-border-color); /* Matches the border perfectly */
        width: 4.3cqh;
        height: 9.6cqh;
        z-index: 2;
        display: flex;
        flex-direction: column;
        align-items: left;
        
        border-bottom-right-radius: 1.79cqh;
    }

    .card-notch h1{
        color: #2b2b2b;
        font-family: 'Barqen', sans-serif;
        line-height: 1;
        
    }

    .card-notch.bottom-right {
        bottom: 2.7cqh; 
        right: 2.7cqh;
        transform: rotate(180deg);
    }

    .card-notch .rank {
        font-size: 6cqh;
        margin: 0.2cqh 0;
    }

    .card-notch .suit {
        font-size: 4.3cqh;
        margin: -1.4cqh 0.2cqh;
    }


    /*  Content  */
    .tool-card-information {
        height: 100%;
        border-radius: 2px;
        overflow: hidden;    
    }


    /* PINK LINES*/
    .tool-card-content::before {
        content: "";
        position: absolute;
        top: 2.7cqh; bottom: 2.7cqh; left: 2.7cqh; right: 2.7cqh;
        z-index: 5;
        pointer-events: none;
        
        border: 0.4cqh solid var(--card-pink-line);
        border-radius: 0.63cqh; 
        
        /* This cuts diagonally across the gaps to hide the border */
        clip-path: polygon(
            20% 0%,    /* Start top edge just after the dot */
            100% 0%,   /* Keep the top-right corner intact */
            110% 61%,    /* Start right edge just before bottom gap */
            72% 110%,    /* Cut the bottom edge */
            -10% 110%,   /* Keep the bottom-left corner intact */
            -10% 40%     /* Cut the left edge */
        );
    }

    /* PINK DOTS */
    .tool-card-content::after {
        content: "";
        position: absolute;
        top: 2.6cqh; bottom: 2.6cqh; left: 2.6cqh; right: 2.6cqh;
        z-index: 5;
        pointer-events: none;
        
        background-image: 
            radial-gradient(circle, var(--card-pink-line) 50%, transparent 55%),
            radial-gradient(circle, var(--card-pink-line) 50%, transparent 55%),
            radial-gradient(circle, var(--card-pink-line) 50%, transparent 55%),
            radial-gradient(circle, var(--card-pink-line) 50%, transparent 55%);
            
        background-repeat: no-repeat;
        background-size: 0.72cqh 0.72cqh;
        
        background-position: 
            left 17% top -0px, 
            right 16% bottom -0px, 
            left 0px top 23%, 
            right 0px bottom 22%;
    }


    .tool-card-thumbnail {
        height: 100%;
        overflow: hidden;
        position: relative;
    }

    .tool-card-thumbnail img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: block;
        border-radius: 0px;
        filter: grayscale(20%);
    }

    .tool-card-thumbnail::after {
        content: "";
        position: absolute;
        inset: 0; 
        mix-blend-mode: multiply;
        
        background: linear-gradient(
            to bottom, 
            #575555 0%, 
            transparent 15%, 
            transparent 75%, 
            #575555 100%
        );
        
        pointer-events: none; 
    }



    .tool-card-title {
        position: absolute; 
        top: 3.8cqh;
        right: 3.8cqh;
        width: 21cqh;
        
        text-align: right;
        font-family: 'Citylight';
        font-size: 4.2cqh;
        font-weight: 100;
        text-transform: uppercase;
        color: #eee7e7;
        background-color: red;
    }


    .tool-card-stack {
        position: absolute; 
        bottom: 3.8cqh;
        left: 3.8cqh;
        display: flex;
        flex-direction: row;
        align-items: center;
        gap: 0.5cqh;
    }

    /* Visibility status */
    .tool-card[data-state="hidden"] { visibility: hidden; pointer-events: none;}

    .tool-card[data-state="empty"] .tool-card-content { display: none; }
    .tool-card[data-state="empty"] .tool-card-empty   { display: flex; }

    .tool-card[data-state="active"] .tool-card-content { display: flex; }
    .tool-card[data-state="active"] .tool-card-empty   { display: none; }


    .tool-card[data-state="active"] {
        animation: flipIn 1.5s cubic-bezier(0.22, 1, 0.36, 1) forwards;
        
    }


    @keyframes dealCard {
        0% {
            opacity: 0;
        }
        20% {
            transform: translateY(-20px) rotate(var(--deal-angle, 0deg)) scale(0.8);
            opacity: 0;
        }
        100% {
            transform: translateY(0) rotate(0deg) scale(1);
            opacity: 1;
        }
    }


    @keyframes flipIn {
        from {
            transform: translateX(20px) rotateY(-90deg) scale(0.9);
            opacity: 0;
        }
        to {
            transform: translateX(0) rotateY(0deg) scale(1);
            opacity: 1;
        }
    }

    @keyframes fadeOut {
        from {
            opacity: 1;
            transform: rotateY(0deg) scale(1);
        }
        to {
            opacity: 0;
            transform: rotateY(-90deg) scale(0.9);
        }
    }

     /* ── MOBILE ── */
	@media (orientation: portrait), (max-aspect-ratio: 9/16) {
        .card-notch {
            width: 4.4cqh;
            height: 9.7cqh;
            border-bottom-right-radius: 2cqh;
        }

        .tool-card-content::before {
            clip-path: polygon(
                20% 0%,    /* Start top edge just after the dot */
                100% 0%,   /* Keep the top-right corner intact */
                110% 61%,    /* Start right edge just before bottom gap */
                78% 110%,    /* Cut the bottom edge */
                -10% 110%,   /* Keep the bottom-left corner intact */
                -10% 35%     /* Cut the left edge */
            );
        }

        .tool-card-content::after {          
            background-position: 
                left 16% top -0px, 
                right 15% bottom -0px, 
                left 0px top 21%, 
                right 0px bottom 20%;
        }

        .card-notch .suit {
            font-size: 3.5cqh;
            margin: -0.5cqh 0.05cqh;
        }


        .tool-card-title {
            top: 4.2cqh;
            right: 4.2cqh;
            font-size: 5cqh;
            width: 23cqh;
        }

        .tool-card-stack {
            bottom: 4.2cqh;
            left: 4.2cqh;
        }

    }


</style>


<script>
    document.querySelectorAll<HTMLElement>('.tool-card[data-href]').forEach(card => {
        card.addEventListener('click', () => {
            const href = card.dataset.href;
            if (href) window.location.href = href;
        });
    });
</script>