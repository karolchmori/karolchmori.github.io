---

import PythonIcon from '../../assets/stack/python.svg';
import QtIcon from '../../assets/stack/qt.svg';
import CPPIcon from '../../assets/stack/cpp.svg';
import CIcon from '../../assets/stack/c.svg';
import CSharpIcon from '../../assets/stack/csharp.svg';
import JavaIcon from '../../assets/stack/java.svg';
import { string } from 'astro:schema';



interface Props {
    name: string;
    size?: string;
    backgroundcolor?: string;
    color?: string;
}

const { name, size = "30px", backgroundcolor = "#34222D", color = "#CBC5C3"} = Astro.props;


const iconMap: Record<string, any> = {
    "Python": PythonIcon,
    "Qt": QtIcon,
    "C++": CPPIcon,
    "C": CIcon,
    "C#": CSharpIcon,
    "Java": JavaIcon,
};

const IconComponent = iconMap[name] ?? null;

---

{IconComponent
    ?   <div class="stack-badge-wrapper">
            <IconComponent style={`color: var(--badgeBGColor); width: var(--badgeSize); height: var(--badgeSize);`} class="stack-badge" />
            <span class="stack-tooltip">{name}</span>
        </div>
    :   <span class="stack-badge stack-badge--text">{name}</span>
}

<style define:vars={{ badgeSize: size, badgeBGColor: backgroundcolor, badgeColor: color }}>


    .stack-badge-wrapper {
        position: relative;
        display: inline-flex;
    }

    .stack-badge-wrapper :global(svg path),
    .stack-badge-wrapper :global(svg circle),
    .stack-badge-wrapper :global(svg rect) {
        fill: var(--badgeBGColor) !important;
    }

    .stack-tooltip {
        position: absolute;
        bottom: calc(100% + 6px);
        left: 50%;
        transform: translateX(-50%);
        
        background: rgba(0,0,0,0.8);
        color: white;
        font-size: 0.65rem;
        padding: 3px 7px;
        border-radius: 4px;
        white-space: nowrap;

        opacity: 0;
        pointer-events: none;
        transition: opacity 0.2s ease;
    }

    .stack-badge-wrapper:hover .stack-tooltip {
        opacity: 1;
    }

    .stack-badge--text {
        font-size: calc(var(--badgeSize)/2);
        padding: 0px 6px;
        border-radius: 4px;
        background: var(--badgeBGColor);
        color: var(--badgeColor);
        font-family: monospace;
    }
</style>