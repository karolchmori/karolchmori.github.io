---
// ProjectCard.astro
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import StackBadge from './StackBadge.astro';
import Icon from '../widgets/Icon.astro';

interface Props {
    entry: CollectionEntry<'tool'>;
}

const { entry } = Astro.props;

const title       = entry.data.title;
const description = entry.data.description;
const thumbnail   = entry.data.thumbnail;
const software    = entry.data.software;
const stack       = entry.data.stack;
const department  = entry.data.department;
const filePath    = entry.id;
const slug        = title.toLowerCase().replace(/\s+/g, '-');


const suits = ['club', 'heart', 'diamond', 'spade'] as const;
const ranks = ["2", "3", "4", "5", "6", "7", "8", "9", "J", "Q", "K", "A"];

const cardRank = ranks[Math.floor(Math.random() * ranks.length)];
const cardSuit = suits[Math.floor(Math.random() * suits.length)];
const isRed = cardSuit === 'heart' || cardSuit === 'diamond';

---

<div class="tool-minicard" data-path={filePath} data-software={software} data-department={department.join(',')} data-stack={stack.join(',')}
    data-state="pending" data-href={`/work/tools/${slug}`} >
    <div class="tool-minicard-content">
        <div class="card-notch top-left" data-red={isRed}>
            <h1 class="rank">{cardRank}</h1>
            <Icon name={cardSuit} size="2.6cqh" class="suit"/>
        </div>
        <div class="tool-minicard-information">
            <div class="tool-minicard-thumbnail">
                {thumbnail
                    ? <Image src={thumbnail} alt={title} />
                    : <div class="tool-minicard-thumbnail-empty" />
                }
            </div>
            <div class="tool-minicard-body">
                <h4 class="tool-minicard-title">{title}</h4>
                <p>{description}</p>
            </div>
            <div class="tool-minicard-stack">
                {stack.map(tech => <StackBadge name={tech}, backgroundcolor='var(--tool-card-black)', color='var(--tool-card-white)' size="2cqh"/>)}
            </div>
        </div>
        
    </div>

    
</div>

<style>

    :root {
        --card-bg: var(--tool-card-bg); 
        --card-pink: var(--tool-card-pink);
        --card-black: var(--tool-card-black);
        --card-white: var(--tool-card-white);
    }


    .tool-minicard {
        width: 100%;
        height: auto; 
        
        overflow: visible;
        cursor: pointer;
        transform-style: preserve-3d;
        border-radius: 16px;

        opacity: 0;
        transform: translateX(20px) rotateY(-90deg) scale(0.9);
    }

    .tool-minicard-content {
        height: 100%;
        position: relative;
        background-color: var(--card-bg);
        box-sizing: border-box;
        border-radius: 1.53cqh;
        width: 96%;
        padding: 2cqh;
    }

    .tool-minicard-content:hover {
        transform: translateY(-6px);
    }


    /* ── CORNERS ── */
    .card-notch {
        position: absolute;
        background-color: var(--card-bg); /* Matches the border perfectly */
        width: 3cqh;
        height: 7cqh;
        z-index: 2;
        display: flex;
        flex-direction: column;
        align-items: left;
        
        border-bottom-right-radius: 1.79cqh;

    }

    .card-notch h1{
        color: var(--card-black);
        font-family: 'Barqen', sans-serif;
        line-height: 1;
        
    }

    .card-notch[data-red="true"] .rank {
        color: var(--card-pink);
    }

    .card-notch[data-red="true"] :global(.suit) {
        color: var(--card-pink);
    }


    .card-notch .rank {
        font-size: 3.7cqh;
        margin: 0.2cqh 0;
    }

    .card-notch :global(.suit) {
        margin: -1cqh -0.3cqh;
        color: var(--card-black);
    }

    /*  Content  */
    .tool-minicard-information {
        height: 98%;
        border-radius: 2px;
        overflow: hidden;    
        border: 0.25cqh solid var(--card-pink);
        border-radius: 0.8cqh; 
        border-bottom-right-radius: 2.5cqh;
    }


    .tool-minicard-thumbnail {
        width: 100%;
        
        overflow: hidden;
        position: relative;
    }

    .tool-minicard-thumbnail img,
    .tool-minicard-thumbnail-empty {
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: block;
        border-radius: 0px;
        filter: grayscale(20%);
    }

    .tool-minicard-thumbnail::after {
        content: "";
        position: absolute;
        inset: 0; 
        mix-blend-mode: multiply;
        
        background: linear-gradient(
            to bottom, 
            #575555af 0%, 
            transparent 25%, 
            transparent 100%
        );
        
        pointer-events: none; 
    }

    .tool-minicard-body {
        padding: 0.65rem 0.75rem 0.4rem;
        flex: 1;
        min-width: 0;
    }

    .tool-minicard-title  {
        position: absolute; 
        top: 3cqh;
        right: 3cqh;
        width: 18cqh;
        
        text-align: right;
        font-family: 'Citylight';
        font-size: 3.2cqh;
        font-weight: 100;
        text-transform: uppercase;
        color: var(--card-white);
    }

    .tool-minicard-body p {
        margin: 0;
        font-size: clamp(0.68rem, 1.1vw, 0.78rem);
        line-height: 1.3;
        color: #3a3f47;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }

    .tool-minicard-stack {
        display: flex;
        flex-wrap: wrap;
        gap: 0.3rem;
        padding: 0 0.75rem 0.6rem;
    }

    /* ── Visibility / filtering states ── */
    .tool-minicard[data-state="active"] {
        animation: flipIn 0.5s ease forwards;
    }

    .tool-minicard[data-state="gone"] {
        display: none;
    }

    .tool-minicard[data-state="leaving"] {
        animation: cardOut 0.22s ease forwards;
        pointer-events: none;
    }

    @keyframes flipIn {
        from {
            transform: translateX(20px) rotateY(-90deg) scale(0.9);
            opacity: 0;
        }
        to {
            transform: translateX(0) rotateY(0deg) scale(1);
            opacity: 1;
        }
    }


    @keyframes cardIn {
        from { opacity: 0; transform: translateY(8px) scale(0.97); }
        to   { opacity: 1; transform: translateY(0) scale(1); }
    }

    @keyframes cardOut {
        from { opacity: 1; transform: scale(1); }
        to   { opacity: 0; transform: scale(0.95); }
    }


    /* ── MOBILE ── */
    @media (orientation: portrait), (max-aspect-ratio: 9/16) {
        .tool-minicard-body {
            padding: 0.5rem 0.6rem 0.3rem;
        }

        .tool-minicard-stack {
            padding: 0 0.6rem 0.5rem;
        }
    }
</style>

<script>
    document.querySelectorAll<HTMLElement>('.tool-minicard[data-href]').forEach(card => {
        card.addEventListener('click', () => {
            const href = card.dataset.href;
            if (href) window.location.href = href;
        });
    });
</script>