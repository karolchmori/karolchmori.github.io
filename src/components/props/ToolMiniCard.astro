---
// ToolMiniCard.astro
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import StackBadge from './StackBadge.astro';
import Icon from '../widgets/Icon.astro';

interface Props {
    entry: CollectionEntry<'tool'>;
}

const { entry } = Astro.props;

const title       = entry?.data.title       ?? "";
const description = entry?.data.description ?? "";
const thumbnail   = entry?.data.thumbnail   ?? null;
const software    = entry?.data.software    ?? "";
const filePath    = entry?.id               ?? null;
const stack       = entry?.data.stack       ?? [];
const department  = entry?.data.department;
const slug        = entry?.data.title.toLowerCase().replace(/\s+/g, '-') ?? null;


const suits = ['club', 'heart', 'diamond', 'spade'] as const;
const ranks = ["2", "3", "4", "5", "6", "7", "8", "9", "J", "K", "A"];

const cardRank = ranks[Math.floor(Math.random() * ranks.length)];
const cardSuit = suits[Math.floor(Math.random() * suits.length)];
const isRed = cardSuit === 'heart' || cardSuit === 'diamond';

---

<div class="tool-minicard" data-path={filePath} data-software={software} data-department={department.join(',')} data-stack={stack.join(',')}
    data-state="pending" data-href={`/work/tools/${slug}`} >
    <div class="tool-minicard-content">
        <div class="card-notch top-left" data-red={isRed}>
            <h1 class="rank">{cardRank}</h1>
            <Icon name={cardSuit} size="11.1cqi" class="suit"/>
        </div>
        <div class="tool-minicard-information">
            <div class="tool-minicard-thumbnail">
                {thumbnail
                    ? <Image src={thumbnail} alt={title} />
                    : <div class="tool-minicard-thumbnail-empty" />
                }
            </div>
            <div class="tool-minicard-body">
                <h4 class="tool-minicard-title">{title}</h4>
                <p class="tool-minicard-description">{description}</p>
                <div class="tool-minicard-stack">
                    {stack.map(tech => <StackBadge name={tech}, backgroundcolor='var(--tool-card-black)', color='var(--tool-card-white)' size="10cqi"/>)}
                </div>
            </div>
            
        </div>
        
    </div>

    
</div>

<style>

    :root {
        --card-bg: var(--tool-card-bg); 
        --card-pink: var(--tool-card-pink);
        --card-black: var(--tool-card-black);
        --card-white: var(--tool-card-white);
        --card-title: var(--tool-card-title);
    }


    .tool-minicard {
        width: 100%;
        height: auto; 
        aspect-ratio: 500 / 650;

        overflow: visible;
        cursor: pointer;
        transform-style: preserve-3d;
        border-radius: 16px;

        box-sizing: border-box;
        opacity: 0;

        container-type: inline-size;
        container-name: tool-minicard;

    }

    .tool-minicard-content {
        height: 96%;
        position: relative;
        background-color: var(--card-bg);
        box-sizing: border-box;
        border-radius: 5.1cqi;
        border-bottom-right-radius: 8.3cqi;
        width: 96%;
        padding: 7.6cqi; 
    }

    .tool-minicard-content:hover {
        transform: translateY(-2cqi);
    }


    /* ── CORNERS ── */
    .card-notch {
        position: absolute;
        background-color: var(--card-bg); 
        width: 12cqi;
        height: 27cqi;
        top: 7cqi;
        z-index: 2;
        display: flex;
        flex-direction: column;
        align-items: left;
        
        border-bottom-right-radius: 6cqi;

    }

    .card-notch h1{
        color: color-mix(in srgb, var(--card-black) 85%, transparent);
        font-family: 'Barqen', sans-serif;
        line-height: 1;
        
    }

    .card-notch[data-red="true"] .rank {
        color: color-mix(in srgb, var(--card-pink) 85%, transparent);
    }

    .card-notch[data-red="true"] :global(.suit) {
        color: color-mix(in srgb, var(--card-pink) 88%, transparent);
    }


    .card-notch .rank {
        font-size: 16cqi;
        margin: 0.6cqi 0;
    }

    .card-notch :global(.suit) {
        margin: -4cqi -1.6cqi;
        color: color-mix(in srgb, var(--card-black) 88%, transparent);
    }

    /*  Content  */
    .tool-minicard-information {
        height: 98%;
        border-radius: 2px;
        overflow: hidden;    
        border: 1.16cqi solid color-mix(in srgb, var(--card-pink) 85%, transparent);
        border-radius: 2.1cqi; 
        border-bottom-right-radius: 8.3cqi;
    }


    .tool-minicard-thumbnail {
        height: 60%;
        overflow: hidden;
        position: relative;
    }

    .tool-minicard-thumbnail img,
    .tool-minicard-thumbnail-empty {
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: block;
        border-radius: 0px;
        filter: grayscale(20%);
    }

    .tool-minicard-thumbnail::after {
        content: "";
        position: absolute;
        inset: 0; 
        mix-blend-mode: multiply;
        
        background: linear-gradient(
            to bottom, 
            #575555af 0%, 
            transparent 25%, 
            transparent 100%
        );
        
        pointer-events: none; 
    }

    .tool-minicard-body {
        padding: 0.65rem 0.75rem 0.4rem;
        flex: 1;
        min-width: 0;
    }

    .tool-minicard-title  {
        position: absolute; 
        top: 14cqi;
        right: 13cqi;
        width: 56cqi;
        
        text-align: right;
        font-family: 'Citylight';
        font-size: 13cqi;
        font-weight: 100;
        text-transform: uppercase;
        color: var(--card-title);
    }

    .tool-minicard-body p {
        margin: 0;
        font-size: 5.3cqi;
        line-height: 1.3;
        color: var(--page-secondaryfont);
        display: -webkit-box;
        -webkit-line-clamp: 3;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }

    .tool-minicard-stack {
        position: absolute; 
        bottom: 14cqi;
        left: 13cqi;
        display: flex;
        flex-direction: row;
        align-items: center;
        gap: 1.6cqi;
    }

    /* ── Visibility / filtering states ── */
    .tool-minicard[data-state="active"] {
        animation: flipIn 0.5s ease forwards;
    }

    .tool-minicard[data-state="gone"] {
        display: none;
    }

    .tool-minicard[data-state="leaving"] {
        animation: cardOut 0.22s ease forwards;
        pointer-events: none;
    }

    @keyframes flipIn {
        from {
            transform: translateX(20px) rotateY(-90deg) scale(0.9);
            opacity: 0;
        }
        to {
            transform: translateX(0) rotateY(0deg) scale(1);
            opacity: 1;
        }
    }


    @keyframes cardIn {
        from { opacity: 0; transform: translateY(8px) scale(0.97); }
        to   { opacity: 1; transform: translateY(0) scale(1); }
    }

    @keyframes cardOut {
        from { opacity: 1; transform: scale(1); }
        to   { opacity: 0; transform: scale(0.95); }
    }


    /* ── MOBILE ── */
    @media (orientation: portrait), (max-aspect-ratio: 9/16) {
        .tool-minicard-body {
            padding: 0.50rem 0.50rem 0.4rem;
        }

        .tool-minicard-thumbnail {
            height: 50%;
        }

        .tool-minicard-body p {
            font-size: 6cqi;
            -webkit-line-clamp: 4;
        }

    }
</style>

<script>
    document.querySelectorAll<HTMLElement>('.tool-minicard[data-href]').forEach(card => {
        card.addEventListener('click', () => {
            const href = card.dataset.href;
            if (href) window.location.href = href;
        });
    });
</script>